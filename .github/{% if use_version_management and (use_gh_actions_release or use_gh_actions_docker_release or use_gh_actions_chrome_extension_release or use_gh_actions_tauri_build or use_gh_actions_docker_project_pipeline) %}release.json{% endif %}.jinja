{% from '_release_config_paths.yml.jinja' import prefix, version_sources, release_paths with context -%}
{% set docker_upstream = use_gh_actions_docker_project_pipeline and docker_project_version_scheme == 'upstream-revision' -%}
{% set docker_multi = docker_upstream and docker_project_release_layout == 'base-process' -%}
{% set docker_authored = docker_multi and docker_project_authored_revision -%}
{% set docker_tag_prefix = docker_release_tag_prefix if (use_gh_actions_docker_release or use_gh_actions_docker_project_pipeline) else '' -%}
{% set revision_suffix = '{revision_suffix}' if docker_upstream else '' -%}
{% set release_paths_json = release_paths | tojson -%}
{
  "version": {
    "scheme": {{ ('upstream-revision' if docker_upstream else ('chrome' if use_chrome_extension else 'semver')) | tojson }},
{% if docker_upstream %}    "revision_path": {{ docker_project_revision_path | tojson }},
{% endif %}{% if docker_authored %}    "revision_policy": "authored",
{% endif %}    "sources": [
{% for source in version_sources %}      {
        "path": {{ source.path | tojson }},
        "format": {{ source.format | tojson }}{% if source.key is defined %},
        "key": {{ source.key | tojson }}{% endif %}
      }{% if not loop.last %},{% endif %}
{% endfor %}    ],
    "locks": {% if use_chrome_extension or use_tauri or use_python or use_rust %}[
{% if use_chrome_extension or use_tauri %}      {
        "path": {{ (prefix ~ 'package-lock.json') | tojson }},
        "format": "json",
        "key": ["version"],
        "optional": true
      },
      {
        "path": {{ (prefix ~ 'package-lock.json') | tojson }},
        "format": "json",
        "key": ["packages", "", "version"],
        "optional": true
      }{% if use_tauri %},
      {
        "path": "src-tauri/Cargo.lock",
        "format": "toml-lock",
        "package": {{ tauri_package_name | tojson }},
        "optional": true
      }{% endif %}
{% elif use_python %}      { "path": "uv.lock", "format": "toml-lock", "package": {{ (project_name | lower | replace("_", "-")) | tojson }}, "optional": true }
{% elif use_rust %}      { "path": "Cargo.lock", "format": "toml-lock", "package": {{ project_name | tojson }}, "optional": true }
{% endif %}    ]{% else %}[]{% endif %}
  },
  "publication": {
    "release_tag": {{ (docker_tag_prefix ~ "{version}" ~ revision_suffix) | tojson }},
    "github_release": {{ (use_gh_actions_release or use_gh_actions_docker_release or use_gh_actions_chrome_extension_release or use_gh_actions_tauri_build or use_gh_actions_docker_project_pipeline) | tojson }},
{% if docker_authored %}    "github_release_prerelease": false,
{% endif %}{# Match the generated Prettier printWidth of 100, including the property and comma. #}
    "release_paths": {{ release_paths_json if (release_paths_json | length) + 22 <= 100 else (release_paths | tojson(indent=2) | indent(4)) }},
{% if use_rust and (use_gh_actions_release or use_gh_actions_docker_release) %}    "rust": {
{% set rust_targets_json = rust_release_targets | tojson %}      "targets": {{ rust_targets_json if (rust_targets_json | length) + 18 <= 100 else (rust_release_targets | tojson(indent=2) | indent(6)) }},
      "smoke_args": ["--help"],
      "stage_command": []
    },
{% endif %}    "latest_image": {% if not docker_multi and (use_gh_actions_docker_release or use_gh_actions_docker_project_pipeline) %}"extended"{% else %}null{% endif %},
    "images": {% if use_gh_actions_docker_release or use_gh_actions_docker_project_pipeline %}[
{% for name in (['base', 'process'] if docker_multi else ['extended']) %}      {
        "name": {{ name | tojson }},
        "repository": {{ (docker_image_name if use_aws_ecr else docker_registry ~ '/' ~ docker_image_name) | tojson }},
        "tag": {{ ('{version}' ~ ('-' ~ name if docker_multi else '') ~ revision_suffix) | tojson }},
        "aliases": {{ '[]' if docker_multi else '["latest"]' }},
        "registry": {{ ('ecr' if use_aws_ecr else 'dockerhub') | tojson }}{% if use_aws_ecr %},
        "account": {{ aws_account_id | tojson }},
        "region": {{ aws_region | tojson }}{% endif %}
      }{% if not loop.last %},{% endif %}
{% endfor %}    ]{% else %}[]{% endif %}
  }
}
