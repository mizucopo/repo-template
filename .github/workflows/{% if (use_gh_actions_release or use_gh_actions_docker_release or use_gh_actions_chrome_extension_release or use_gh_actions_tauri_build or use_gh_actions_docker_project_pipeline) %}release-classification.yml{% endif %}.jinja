{% from "_action_pins.yml.jinja" import action %}name: Release Classification

on:
  pull_request:
    types: [opened, reopened, synchronize, edited, labeled, unlabeled]

permissions:
  contents: read
  pull-requests: read

jobs:
  release-classification:
    if: github.event.pull_request.state == 'open'
    runs-on: ubuntu-latest
    steps:
      - uses: {{ action('actions/checkout') }}
      - name: Validate classification when required by version scheme
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
        run: python3 -I .github/scripts/release.py classification
