name: Release

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Read version
        id: version
        run: |
{%- if use_chrome_extension or use_tauri %}
          echo "version=$(awk -F'\"' '/\"version\":/ {print $4; exit}' package.json)" >> "$GITHUB_OUTPUT"
{%- elif use_python %}
          echo "version=$(awk -F'\"' '/^version *=/ {print $2}' pyproject.toml)" >> "$GITHUB_OUTPUT"
{%- elif use_rust %}
          echo "version=$(awk -F'\"' '/^version *=/ {print $2; exit}' Cargo.toml)" >> "$GITHUB_OUTPUT"
{%- else %}
          echo "version=$(cat version)" >> "$GITHUB_OUTPUT"
{%- endif %}

      - name: Configure Git
        env:
          GIT_USER_NAME: {{ author_name | tojson }}
          GIT_USER_EMAIL: {{ author_email | tojson }}
        run: |
          git config user.name "$GIT_USER_NAME"
          git config user.email "$GIT_USER_EMAIL"

      - name: Check if tag exists
        run: |
          git fetch --tags
          if git rev-parse "{{ '${{ steps.version.outputs.version }}' }}" >/dev/null 2>&1; then
            exit 1
          fi

      - name: Create and push git tag
        run: |
          git tag -a "{{ '${{ steps.version.outputs.version }}' }}" -m "Release {{ '${{ steps.version.outputs.version }}' }}"
          git push origin "{{ '${{ steps.version.outputs.version }}' }}"

      - name: Create GitHub Release
        env:
          GITHUB_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}
        run: |
          gh release create "{{ '${{ steps.version.outputs.version }}' }}" \
            --title "Release {{ '${{ steps.version.outputs.version }}' }}" \
            --notes "## Links:

          - [Source Code]({{ '${{ github.server_url }}/${{ github.repository }}/tree/${{ steps.version.outputs.version }}' }})
          "
