name: Release

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Read version
        id: version
        run: |
{%- if use_chrome_extension or use_tauri %}
          echo "version=$(awk -F'\"' '/\"version\":/ {print $4; exit}' package.json)" >> "$GITHUB_OUTPUT"
{%- elif use_python %}
          echo "version=$(awk -F'\"' '/^version *=/ {print $2}' pyproject.toml)" >> "$GITHUB_OUTPUT"
{%- elif use_rust %}
          echo "version=$(awk -F'\"' '/^version *=/ {print $2; exit}' Cargo.toml)" >> "$GITHUB_OUTPUT"
{%- else %}
          echo "version=$(cat version)" >> "$GITHUB_OUTPUT"
{%- endif %}

      - name: Configure Git
        env:
          GIT_USER_NAME: {{ author_name | tojson }}
          GIT_USER_EMAIL: {{ author_email | tojson }}
        run: |
          git config user.name "$GIT_USER_NAME"
          git config user.email "$GIT_USER_EMAIL"

      - name: Create or reuse version tag
        env:
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: |
          git fetch --tags
          HEAD_SHA="$(git rev-parse HEAD)"

          if git show-ref --tags --verify --quiet "refs/tags/$TAG"; then
            TAG_SHA="$(git rev-list -n 1 "refs/tags/$TAG")"
            if [ "$TAG_SHA" != "$HEAD_SHA" ]; then
              echo "::error::Tag $TAG already points to $TAG_SHA, not $HEAD_SHA."
              exit 1
            fi
            echo "Tag $TAG already points to this release commit; reusing it."
          else
            git tag -a "$TAG" -m "Release $TAG"
            git push origin "$TAG"
          fi

      - name: Create or reuse GitHub Release
        env:
          GH_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: |
          if gh release view "$TAG" >/dev/null 2>&1; then
            echo "GitHub Release $TAG already exists; reusing it."
          else
            gh release create "$TAG" \
              --title "Release $TAG" \
              --notes "## Links:

          - [Source Code]({{ '${{ github.server_url }}/${{ github.repository }}/tree/' }}$TAG)
          "
          fi
