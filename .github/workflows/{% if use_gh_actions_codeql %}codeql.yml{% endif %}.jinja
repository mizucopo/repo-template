{% from "_action_pins.yml.jinja" import action %}name: CodeQL

on:
  pull_request:
    branches:
      - main
  push:
    branches:
      - main
  schedule:
    - cron: "17 3 * * 1"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  analyze:
    name: {% raw %}Analyze (${{ matrix.language }}){% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      security-events: write
    strategy:
      fail-fast: false
      matrix:
        language: {{ codeql_languages | tojson }}
    steps:
      - name: Checkout
        uses: {{ action('actions/checkout') }}
        with:
          persist-credentials: false
      - name: Initialize CodeQL
        uses: {{ action('github/codeql-action/init') }}
        with:
          languages: {% raw %}${{ matrix.language }}{% endraw %}
          build-mode: none
      - name: Analyze
        uses: {{ action('github/codeql-action/analyze') }}
        with:
          category: {% raw %}"/language:${{ matrix.language }}"{% endraw %}
