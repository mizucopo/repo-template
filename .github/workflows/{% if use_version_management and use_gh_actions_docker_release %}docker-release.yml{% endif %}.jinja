name: Docker Release

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: read
{% if use_aws_ecr %}  id-token: write
{% endif %}
concurrency:
  group: release-main
  cancel-in-progress: false
  queue: max

jobs:
{% include '_release_prepare.yml.jinja' %}
  release:
    needs: prepare
    if: needs.prepare.outputs.publish == 'true'
    runs-on: ubuntu-latest
    outputs:
      is_prerelease: {{ '${{ steps.metadata.outputs.is_prerelease }}' }}
    env:
      RELEASE_SHA: {{ '${{ needs.prepare.outputs.release_sha }}' }}
{% if not use_aws_ecr %}      DOCKERHUB_USERNAME: {{ docker_login_username | tojson }}
      DOCKERHUB_TOKEN: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{% endif %}
    steps:
      - name: Checkout numbering commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ needs.prepare.outputs.release_sha }}' }}
          fetch-depth: 0

{% filter trim('\n') -%}
{% include '_release_checkout.yml.jinja' %}
{% endfilter %}
{% filter trim('\n') -%}
{% include '_release_validate.yml.jinja' %}
{% endfilter %}
{% if use_aws_ecr %}
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@e6de054238d6b7531b4efff3b6587d9aade6a06c # v6.2.3
        with:
          role-to-assume: {{ '${{ secrets.AWS_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}
{% endif %}
      - name: Inspect versioned image
        id: image-state
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
        run: python3 -I .github/scripts/release.py image-state
      - name: Classify release version
        id: metadata
        run: |
          is_prerelease="$(jq -er '.publication.is_prerelease | select(type == "boolean") | tostring' "$RELEASE_PLAN_OUTPUT")"
          echo "is_prerelease=$is_prerelease" >> "$GITHUB_OUTPUT"
      - name: Inspect GitHub Release
        id: release-state
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ needs.prepare.outputs.release_tag }}' }}
          INSPECT_DRAFT_RELEASES: "true"
        run: |
{% filter trim | indent(width=10, first=True) -%}
{% include '_release_state_reader.sh.jinja' %}
{% endfilter %}
      - name: Reject incomplete public release
        if: steps.release-state.outputs.release_exists == 'true' && steps.release-state.outputs.release_is_draft != 'true' && steps.image-state.outputs.version_exists != 'true'
        run: |
          echo '::error::Published versioned image is missing; refusing to overwrite the release.'
          exit 1
      - name: Verify existing image ownership
        if: steps.image-state.outputs.version_exists == 'true'
        env:
          TAG: {{ '${{ steps.image-state.outputs.image_tag }}' }}
        run: bash .github/scripts/manage-docker-image-owner.sh verify "$TAG"
      - name: Build and validate native image
        if: steps.image-state.outputs.version_exists != 'true'
        run: |
          docker build --check .
          docker build -t release-check .
{% if docker_smoke_command | default('') %}          docker run --rm release-check {{ docker_smoke_command }}
{% endif %}{% if 'linux/arm64' in docker_release_platforms %}
      - name: Set up QEMU
        if: steps.image-state.outputs.version_exists != 'true'
        uses: docker/setup-qemu-action@1f40c72289eff860ee54a304f1438e3cff362e0a # v4.3.0
        with:
          platforms: arm64
{% endif %}
      - name: Set up Docker Buildx
        if: steps.image-state.outputs.version_exists != 'true'
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4.2.0
{% if use_aws_ecr %}
      - name: Login to Amazon ECR
        if: steps.image-state.outputs.version_exists != 'true'
        uses: aws-actions/amazon-ecr-login@d539f0932e70871a027e9d5a9d8fc38589180a64 # v2.1.6
{% else %}
      - name: Login to Docker Hub
        if: steps.image-state.outputs.version_exists != 'true'
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          username: {{ docker_login_username | tojson }}
          password: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{% endif %}
      - name: Reserve image ownership
        if: steps.image-state.outputs.version_exists != 'true'
        env:
          TAG: {{ '${{ steps.image-state.outputs.image_tag }}' }}
        run: bash .github/scripts/manage-docker-image-owner.sh record "$TAG"
      - name: Build and push immutable image
        if: steps.image-state.outputs.version_exists != 'true'
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7.3.0
        with:
          context: .
          push: true
{% if docker_release_platforms %}          platforms: {{ docker_release_platforms | join(',') | tojson }}
{% endif %}          tags: {{ docker_registry }}/{{ docker_image_name }}:{{ '${{ steps.image-state.outputs.image_tag }}' }}
      - name: Verify published image
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
        run: |
          : > "$RUNNER_TEMP/image-state"
          GITHUB_OUTPUT="$RUNNER_TEMP/image-state" python3 -I .github/scripts/release.py image-state
          grep -qx version_exists=true "$RUNNER_TEMP/image-state"
      - name: Create GitHub Release
        id: create-release
        if: steps.release-state.outputs.release_exists != 'true'
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ needs.prepare.outputs.release_tag }}' }}
          IS_PRERELEASE: {{ '${{ steps.metadata.outputs.is_prerelease }}' }}
{% if use_rust %}          RELEASE_DRAFT: "true"
{% endif %}        run: python3 -I .github/scripts/release.py create

{% filter trim('\n') -%}
{% include '_release_distribution.yml.jinja' %}
{% endfilter %}

  promote-latest:
    needs: [prepare, release]
    if: needs.prepare.outputs.publish == 'true' && needs.release.outputs.is_prerelease == 'false'
    runs-on: ubuntu-latest
    env:
      RELEASE_SHA: {{ '${{ needs.prepare.outputs.release_sha }}' }}
    steps:
      - name: Checkout numbering commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ needs.prepare.outputs.release_sha }}' }}
          fetch-depth: 0

{% include '_release_checkout.yml.jinja' %}
      - name: Check newest completed release
        id: latest-state
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
        run: python3 -I .github/scripts/release.py latest
      - name: Set up Docker Buildx
        if: steps.latest-state.outputs.promote_latest == 'true'
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4.2.0
{% if use_aws_ecr %}
      - name: Configure AWS credentials
        if: steps.latest-state.outputs.promote_latest == 'true'
        uses: aws-actions/configure-aws-credentials@e6de054238d6b7531b4efff3b6587d9aade6a06c # v6.2.3
        with:
          role-to-assume: {{ '${{ secrets.AWS_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}
      - name: Login to Amazon ECR
        if: steps.latest-state.outputs.promote_latest == 'true'
        uses: aws-actions/amazon-ecr-login@d539f0932e70871a027e9d5a9d8fc38589180a64 # v2.1.6
{% else %}
      - name: Login to Docker Hub
        if: steps.latest-state.outputs.promote_latest == 'true'
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          username: {{ docker_login_username | tojson }}
          password: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{% endif %}
      - name: Publish latest image
        if: steps.latest-state.outputs.promote_latest == 'true'
        env:
          IMAGE_REPOSITORY: {{ (docker_registry ~ '/' ~ docker_image_name) | tojson }}
          TAG: {{ '${{ steps.latest-state.outputs.image_tag }}' }}
        run: docker buildx imagetools create --prefer-index=false --tag "$IMAGE_REPOSITORY:latest" "$IMAGE_REPOSITORY:$TAG"
      - name: Mark GitHub Release as latest
        if: steps.latest-state.outputs.promote_latest == 'true'
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ steps.latest-state.outputs.release_tag }}' }}
        run: gh release edit "$TAG" --latest
