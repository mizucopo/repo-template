{% import "_language_toolchain.jinja" as tools %}{% from "_action_pins.yml.jinja" import action %}name: Rust Quality Checks

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  rust-quality-checks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: {{ action('actions/checkout') }}

      - name: Install Rust toolchain
        run: rustup show

      - name: Run quality gate
        timeout-minutes: 15
        run: |
          cargo fmt --all --check
          cargo clippy --all-targets --all-features -- -D warnings
          cargo test --all-targets --all-features
{% if use_gh_actions_native_pr | default(false) %}{% include '_native_pr_job.yml.jinja' %}{% endif -%}
