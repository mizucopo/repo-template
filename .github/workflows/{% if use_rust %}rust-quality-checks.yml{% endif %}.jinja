name: Rust Quality Checks

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read
  checks: write

jobs:
  rust-quality-checks:
    continue-on-error: true
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Rust toolchain
        run: rustup show

      - name: Run rustfmt check
        id: rustfmt
        continue-on-error: true
        run: |
          if cargo fmt --all --check > rustfmt_output.txt 2>&1; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Run Clippy
        id: clippy
        continue-on-error: true
        run: |
          if cargo clippy --all-targets --all-features -- -D warnings > clippy_output.txt 2>&1; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Run cargo test
        id: cargo-test
        continue-on-error: true
        timeout-minutes: 10
        run: |
          cargo test --all-targets --all-features 2>&1 | tee cargo_test_output.txt
          CARGO_TEST_EXIT=${PIPESTATUS[0]}
          if [ "$CARGO_TEST_EXIT" -eq 0 ]; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗 (終了コード: $CARGO_TEST_EXIT)"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Build Rust quality check summary
        id: rust-quality-report
        if: always()
        run: |
          cat > rust_quality_report.md <<'EOF'
          ## Rust Quality Checks Result

          | Item | Result |
          |-------------|------|
          | rustfmt | {{ '${{ steps.rustfmt.outputs.result }}' }} |
          | Clippy | {{ '${{ steps.clippy.outputs.result }}' }} |
          | cargo test | {{ '${{ steps.cargo-test.outputs.result }}' }} |
          EOF

          cat rust_quality_report.md >> "$GITHUB_STEP_SUMMARY"

          {
            echo "summary<<EOF"
            cat rust_quality_report.md
            echo "EOF"
          } >> "$GITHUB_OUTPUT"

      - name: Publish Rust quality check
        if: always() && github.event_name == 'pull_request' && github.event.pull_request.head.repo.fork == false
        uses: actions/github-script@v7
        continue-on-error: true
        env:
          SUMMARY: {{ '${{ steps.rust-quality-report.outputs.summary }}' }}
          RUSTFMT_RESULT: {{ '${{ steps.rustfmt.outputs.result }}' }}
          CLIPPY_RESULT: {{ '${{ steps.clippy.outputs.result }}' }}
          CARGO_TEST_RESULT: {{ '${{ steps.cargo-test.outputs.result }}' }}
        with:
          script: |
            const results = [
              process.env.RUSTFMT_RESULT,
              process.env.CLIPPY_RESULT,
              process.env.CARGO_TEST_RESULT,
            ];
            const allPassed = results.every((result) => result?.includes("成功"));

            let checkConclusion = "failure";
            let checkTitle = "❌ Rust quality checks failed";
            if (allPassed) {
              checkConclusion = "success";
              checkTitle = "All Rust quality checks passed";
            }

            await github.rest.checks.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              name: "Rust Quality Checks Result",
              head_sha: context.payload.pull_request.head.sha,
              status: "completed",
              conclusion: checkConclusion,
              output: {
                title: checkTitle,
                summary: process.env.SUMMARY,
              },
            });
