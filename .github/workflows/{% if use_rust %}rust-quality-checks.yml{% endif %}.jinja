name: Rust Quality Checks

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  rust-quality-checks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Rust toolchain
        run: rustup show

      - name: Run rustfmt check
        id: rustfmt
        continue-on-error: true
        run: cargo fmt --all --check

      - name: Run Clippy
        id: clippy
        continue-on-error: true
        run: cargo clippy --all-targets --all-features -- -D warnings

      - name: Run cargo test
        id: cargo-test
        continue-on-error: true
        timeout-minutes: 10
        run: cargo test --all-targets --all-features

      - name: Build Rust quality check summary
        id: rust-quality-report
        if: {{ '${{ !cancelled() }}' }}
        env:
          RUSTFMT_OUTCOME: {{ '${{ steps.rustfmt.outcome }}' }}
          CLIPPY_OUTCOME: {{ '${{ steps.clippy.outcome }}' }}
          CARGO_TEST_OUTCOME: {{ '${{ steps.cargo-test.outcome }}' }}
        run: |
          format_result() {
            case "$1" in
              success) printf '✅ 成功' ;;
              failure) printf '❌ 失敗' ;;
              skipped) printf '⏭️ スキップ' ;;
              *) printf '❓ %s' "${1:-unknown}" ;;
            esac
          }

          cat > rust_quality_report.md <<EOF
          ## Rust Quality Checks Result

          | Item | Result |
          |-------------|------|
          | rustfmt | $(format_result "$RUSTFMT_OUTCOME") |
          | Clippy | $(format_result "$CLIPPY_OUTCOME") |
          | cargo test | $(format_result "$CARGO_TEST_OUTCOME") |
          EOF

          cat rust_quality_report.md >> "$GITHUB_STEP_SUMMARY"

          HAS_FAILURE=false
          for outcome in \
            "$RUSTFMT_OUTCOME" \
            "$CLIPPY_OUTCOME" \
            "$CARGO_TEST_OUTCOME"; do
            if [ "$outcome" != "success" ]; then
              HAS_FAILURE=true
            fi
          done
          echo "has-failure=$HAS_FAILURE" >> "$GITHUB_OUTPUT"

      - name: Enforce quality gate result
        if: {{ "${{ !cancelled() && steps.rust-quality-report.outputs.has-failure == 'true' }}" }}
        run: |
          echo "::error::One or more Rust quality checks failed or were skipped."
          exit 1
