name: Merge Preparation

on:
  workflow_run:
    workflows:
      - Merge Preparation Events
{% if use_python %}      - PR Quality Checks
{% endif %}{% if use_rust %}      - Rust Quality Checks
{% endif %}{% if use_chrome_extension %}      - Chrome Extension Quality Checks
{% endif %}{% if use_tauri %}      - Tauri Quality Checks
{% endif %}{% if use_gh_actions_docker_quality %}      - Docker Quality Checks
{% endif %}{% if use_gh_actions_docker_project_pipeline %}      - Docker Project Quality Checks
{% endif %}    types: [in_progress, completed]
  workflow_dispatch:

permissions:
  contents: read
  actions: read
{% if use_aws_ecr %}  id-token: write
{% endif %}
concurrency:
  group: merge-preparation-controller
  cancel-in-progress: false

jobs:
  prepare:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    environment: merge-preparation
    steps:
      - name: Checkout trusted default-branch control code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ github.sha }}' }}
          fetch-depth: 0
          persist-credentials: false
      - name: Validate Environment and execution ref before using credentials
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
        run: python3 -I .github/scripts/merge-preparation.py environment-check
      - name: Validate dedicated App configuration
        env:
          MERGE_PREPARATION_APP_PRIVATE_KEY: {{ '${{ secrets.MERGE_PREPARATION_APP_PRIVATE_KEY }}' }}
          MERGE_PREPARATION_PUBLIC_KEYS: {{ '${{ vars.MERGE_PREPARATION_PUBLIC_KEYS }}' }}
          MERGE_PREPARATION_APP_CLIENT_ID: {{ '${{ vars.MERGE_PREPARATION_APP_CLIENT_ID }}' }}
          MERGE_PREPARATION_APP_ID: {{ '${{ vars.MERGE_PREPARATION_APP_ID }}' }}
          MERGE_PREPARATION_APP_BOT_ID: {{ '${{ vars.MERGE_PREPARATION_APP_BOT_ID }}' }}
        run: python3 -I .github/scripts/merge-preparation.py configuration-check
      - name: Create dedicated App installation token
        id: app
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          client-id: {{ '${{ vars.MERGE_PREPARATION_APP_CLIENT_ID }}' }}
          private-key: {{ '${{ secrets.MERGE_PREPARATION_APP_PRIVATE_KEY }}' }}
          owner: {{ '${{ github.repository_owner }}' }}
          repositories: {{ '${{ github.event.repository.name }}' }}
{% if use_aws_ecr %}
      - name: Require ECR collision lookup configuration
        env:
          ECR_READ_ROLE: {{ '${{ secrets.MERGE_PREPARATION_ECR_READ_ROLE_ARN }}' }}
        run: |
          test -n "$ECR_READ_ROLE" || { echo '::error::Register an ECR read-only role in merge-preparation Environment; see docs/merge-preparation.md.'; exit 1; }
      - name: Configure ECR read-only collision lookup
        uses: aws-actions/configure-aws-credentials@e6de054238d6b7531b4efff3b6587d9aade6a06c # v6.2.3
        with:
          role-to-assume: {{ '${{ secrets.MERGE_PREPARATION_ECR_READ_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}
{% endif %}
      - name: Reconcile classification, numbering and trusted CI
        env:
          GH_TOKEN: {{ '${{ steps.app.outputs.token }}' }}
          MERGE_PREPARATION_APP_PRIVATE_KEY: {{ '${{ secrets.MERGE_PREPARATION_APP_PRIVATE_KEY }}' }}
          MERGE_PREPARATION_PUBLIC_KEYS: {{ '${{ vars.MERGE_PREPARATION_PUBLIC_KEYS }}' }}
          MERGE_PREPARATION_APP_ID: {{ '${{ vars.MERGE_PREPARATION_APP_ID }}' }}
          MERGE_PREPARATION_APP_BOT_ID: {{ '${{ vars.MERGE_PREPARATION_APP_BOT_ID }}' }}
          DOCKERHUB_USERNAME: {{ '${{ vars.DOCKERHUB_USERNAME }}' }}
          DOCKERHUB_TOKEN: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
        run: python3 -I .github/scripts/merge-preparation.py reconcile
