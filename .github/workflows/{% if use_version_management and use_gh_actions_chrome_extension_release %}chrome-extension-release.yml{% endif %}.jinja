name: Chrome Extension Distribution Release

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: read
{% if use_aws_ecr %}  id-token: write
{% endif %}
concurrency:
  group: release-main
  cancel-in-progress: false
  queue: max

jobs:
{% include '_release_prepare.yml.jinja' %}
  release:
    needs: prepare
    if: needs.prepare.outputs.publish == 'true'
    runs-on: ubuntu-latest
    env:
      RELEASE_SHA: {{ '${{ needs.prepare.outputs.release_sha }}' }}
      VERSION: {{ '${{ needs.prepare.outputs.version }}' }}
      PACKAGE_ROOT: {{ (chrome_extension_release_package_root_directory | replace('\\', '/')) | tojson }}
    steps:
      - name: Checkout numbering commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ needs.prepare.outputs.release_sha }}' }}
          fetch-depth: 0

{% include '_release_checkout.yml.jinja' %}
      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version-file: .node-version
      - name: Prepare distribution metadata
        id: release-metadata
        env:
          NOTES_TEMPLATE: {{ chrome_extension_release_notes | tojson }}
        run: |
          node <<'NODE'
          const fs = require("fs");
          const path = require("path");
          const event = JSON.parse(fs.readFileSync(process.env.GITHUB_EVENT_PATH, "utf8"));
          const repository = event.repository?.full_name;
          if (typeof repository !== "string" || repository !== repository.trim() || !/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(repository)) {
            throw new Error("Event repository.full_name must use owner/repository format.");
          }
          const zipName = `${repository.split("/")[1]}-${process.env.VERSION}.zip`;
          const zipPath = path.join(process.env.RUNNER_TEMP, zipName);
          const notesPath = path.join(process.env.RUNNER_TEMP, "release-notes.md");
          fs.writeFileSync(notesPath, process.env.NOTES_TEMPLATE.replaceAll("{version}", process.env.VERSION));
          fs.appendFileSync(process.env.GITHUB_OUTPUT,
            `zip_name=${zipName}\nzip_path=${zipPath}\nrelease_notes_path=${notesPath}\n`);
          NODE
      - name: Inspect release state
        id: release-state
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ needs.prepare.outputs.release_tag }}' }}
          RELEASE_ASSET_NAME: {{ '${{ steps.release-metadata.outputs.zip_name }}' }}
          INSPECT_DRAFT_RELEASES: "true"
        run: |
{% filter trim | indent(width=10, first=True) -%}
{% include '_release_state_reader.sh.jinja' %}
{% endfilter %}
      - name: Reject incomplete public release
        if: steps.release-state.outputs.release_exists == 'true' && steps.release-state.outputs.release_is_draft != 'true' && steps.release-state.outputs.release_asset_exists != 'true'
        run: |
          echo '::error::Published distribution asset is missing; refusing to overwrite the release.'
          exit 1
      - name: Build and validate distribution
        if: steps.release-state.outputs.release_asset_exists != 'true'
        working-directory: {{ '${{ env.PACKAGE_ROOT }}' }}
        env:
          ZIP_PATH: {{ '${{ steps.release-metadata.outputs.zip_path }}' }}
        run: |
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
          npm run check
          node --input-type=module <<'NODE'
          import fs from "node:fs";
          const manifest = JSON.parse(fs.readFileSync("dist/manifest.json", "utf8"));
          if (manifest.version !== process.env.VERSION) throw new Error("Distribution version differs from numbered version");
          NODE
          cd dist
          zip -r "$ZIP_PATH" .
      - name: Create draft
        if: steps.release-state.outputs.release_exists != 'true'
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ needs.prepare.outputs.release_tag }}' }}
          NOTES_PATH: {{ '${{ steps.release-metadata.outputs.release_notes_path }}' }}
        run: gh release create "$TAG" --verify-tag --draft --latest=false --title "$TAG" --notes-file "$NOTES_PATH"
      - name: Upload missing distribution
        if: steps.release-state.outputs.release_asset_exists != 'true'
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ needs.prepare.outputs.release_tag }}' }}
          ZIP_PATH: {{ '${{ steps.release-metadata.outputs.zip_path }}' }}
        run: gh release upload "$TAG" "$ZIP_PATH" --clobber
      - name: Publish complete draft
        if: steps.release-state.outputs.release_is_draft == 'true' || steps.release-state.outputs.release_exists != 'true'
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ needs.prepare.outputs.release_tag }}' }}
          RELEASE_ASSET_NAME: {{ '${{ steps.release-metadata.outputs.zip_name }}' }}
          INSPECT_DRAFT_RELEASES: "true"
        run: |
{% filter trim | indent(width=10, first=True) -%}
{% include '_release_state_reader.sh.jinja' %}
{% endfilter %}
          test "$release_is_draft" = true
          test "$release_asset_exists" = true
          gh release edit "$TAG" --draft=false

  promote-latest:
    needs: [prepare, release]
    runs-on: ubuntu-latest
    env:
      RELEASE_SHA: {{ '${{ needs.prepare.outputs.release_sha }}' }}
    outputs:
      promoted: {{ '${{ steps.latest-state.outputs.promote_latest }}' }}
    steps:
      - name: Checkout numbering commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ needs.prepare.outputs.release_sha }}' }}
          fetch-depth: 0

{% include '_release_checkout.yml.jinja' %}
      - name: Check newest completed release
        id: latest-state
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
        run: python3 -I .github/scripts/release.py latest
      - name: Mark GitHub Release as latest
        if: steps.latest-state.outputs.promote_latest == 'true'
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          TAG: {{ '${{ steps.latest-state.outputs.release_tag }}' }}
        run: gh release edit "$TAG" --latest
