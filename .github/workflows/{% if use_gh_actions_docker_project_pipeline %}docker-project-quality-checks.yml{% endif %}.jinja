{% from "_action_pins.yml.jinja" import action %}name: Docker Project Quality Checks

on:
  pull_request:

permissions:
  contents: read

jobs:
  docker-project-quality-checks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: {{ action('actions/checkout') }}
        with:
          persist-credentials: false

      - name: Set up Python
        uses: {{ action('actions/setup-python') }}
        with:
          python-version: "3.14"

      - name: Set up Docker Buildx
        uses: {{ action('docker/setup-buildx-action') }}

      - name: Run project Docker quality checks
        env:
          IMAGE_REPOSITORY: {{ (docker_registry ~ '/' ~ docker_image_name) | tojson }}
        run: python3 .github/scripts/docker-image-pipeline.py quality
