name: Docker Release

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: write
{%- if use_aws_ecr %}
  id-token: write
{%- endif %}

jobs:
  docker-release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Read version
        id: version
        run: |
{%- if use_chrome_extension or use_tauri %}
          echo "version=$(awk -F'\"' '/\"version\":/ {print $4; exit}' package.json)" >> "$GITHUB_OUTPUT"
{%- elif use_python %}
          echo "version=$(awk -F'\"' '/^version *=/ {print $2}' pyproject.toml)" >> "$GITHUB_OUTPUT"
{%- elif use_rust %}
          echo "version=$(awk -F'\"' '/^version *=/ {print $2; exit}' Cargo.toml)" >> "$GITHUB_OUTPUT"
{%- else %}
          echo "version=$(cat version)" >> "$GITHUB_OUTPUT"
{%- endif %}

      - name: Configure Git
        env:
          GIT_USER_NAME: {{ author_name | tojson }}
          GIT_USER_EMAIL: {{ author_email | tojson }}
        run: |
          git config user.name "$GIT_USER_NAME"
          git config user.email "$GIT_USER_EMAIL"

      - name: Create or reuse version tag
        env:
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: |
          git fetch --tags
          HEAD_SHA="$(git rev-parse HEAD)"

          if git show-ref --tags --verify --quiet "refs/tags/$TAG"; then
            TAG_SHA="$(git rev-list -n 1 "refs/tags/$TAG")"
            if [ "$TAG_SHA" != "$HEAD_SHA" ]; then
              echo "::error::Tag $TAG already points to $TAG_SHA, not $HEAD_SHA."
              exit 1
            fi
            echo "Tag $TAG already points to this release commit; reusing it."
          else
            git tag -a "$TAG" -m "Release $TAG"
            git push origin "$TAG"
          fi

{%- if use_aws_ecr %}

      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: {{ '${{ secrets.AWS_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}

      - name: Login to Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2
{%- else %}

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: {{ docker_registry }}
          password: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{%- endif %}

      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: |
            {{ docker_registry }}/{{ docker_image_name }}:latest
            {{ docker_registry }}/{{ docker_image_name }}:{{ '${{ steps.version.outputs.version }}' }}

      - name: Create or reuse GitHub Release
        env:
          GH_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: |
          if gh release view "$TAG" >/dev/null 2>&1; then
            echo "GitHub Release $TAG already exists; reusing it."
          else
            gh release create "$TAG" \
              --title "Release $TAG" \
              --notes "## Docker Image

          Pull the Docker image:

          \`\`\`bash
{%- if use_aws_ecr %}
          aws ecr get-login-password --region {{ aws_region }} | \\
            docker login --username AWS --password-stdin {{ aws_account_id }}.dkr.ecr.{{ aws_region }}.amazonaws.com
{%- endif %}
          docker pull {{ docker_registry }}/{{ docker_image_name }}:$TAG
          \`\`\`

          Or use the latest tag:

          \`\`\`bash
{%- if use_aws_ecr %}
          aws ecr get-login-password --region {{ aws_region }} | \\
            docker login --username AWS --password-stdin {{ aws_account_id }}.dkr.ecr.{{ aws_region }}.amazonaws.com
{%- endif %}
          docker pull {{ docker_registry }}/{{ docker_image_name }}:latest
          \`\`\`

          ## Links:

{%- if use_aws_ecr %}
          - [ECR](https://{{ aws_region }}.console.aws.amazon.com/ecr/repositories/private/{{ aws_account_id }}/{{ docker_image_name }}/_/details?region={{ aws_region }})
{%- else %}
          - [Docker Hub](https://hub.docker.com/r/{{ docker_registry }}/{{ docker_image_name }})
{%- endif %}
          - [Source Code]({{ '${{ github.server_url }}/${{ github.repository }}/tree/' }}$TAG)
          "
          fi
