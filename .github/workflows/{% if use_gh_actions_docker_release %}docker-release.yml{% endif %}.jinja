name: Docker Release

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  actions: read
  contents: write
{%- if use_aws_ecr %}
  id-token: write
{%- endif %}

jobs:
  resolve-version:
    runs-on: ubuntu-latest
    outputs:
      version: {{ '${{ steps.version.outputs.version }}' }}
      concurrency-key: {{ '${{ steps.concurrency-key.outputs.key }}' }}
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Resolve version
        id: version
        run: |
{% filter indent(width=10, first=True) -%}
{% include '_release_version_reader.sh.jinja' %}
{% endfilter %}

      - name: Derive concurrency key
        id: concurrency-key
        env:
          VERSION: {{ '${{ steps.version.outputs.version }}' }}
        run: |
          key="$(printf '%s' "$VERSION" | sha256sum | cut -d ' ' -f 1)"
          echo "key=$key" >> "$GITHUB_OUTPUT"

  docker-release:
    needs: resolve-version
    concurrency:
      group: docker-release-{{ '${{ needs.resolve-version.outputs.concurrency-key }}' }}
      cancel-in-progress: false
    runs-on: ubuntu-latest
    steps:
      - name: Require main
        run: |
          set -euo pipefail

          if [ "${GITHUB_REF}" != "refs/heads/main" ]; then
            echo "This workflow can only release from main." >&2
            exit 1
          fi

      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - name: Read version
        id: version
        run: |
{% filter indent(width=10, first=True) -%}
{% include '_release_version_reader.sh.jinja' %}
{% endfilter %}

      - name: Inspect release state
        id: release-state
        env:
          GH_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: |
{% filter indent(width=10, first=True) -%}
{% include '_release_state_reader.sh.jinja' %}
{% endfilter %}

{%- if use_aws_ecr %}

      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@e6de054238d6b7531b4efff3b6587d9aade6a06c # v6.2.3
        with:
          role-to-assume: {{ '${{ secrets.AWS_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}
{%- endif %}

      - name: Inspect Docker image state
        id: image-state
        env:
{%- if use_aws_ecr %}
          ECR_REGISTRY_ID: {{ aws_account_id | tojson }}
          ECR_REPOSITORY: {{ docker_image_name | tojson }}
{%- else %}
          DOCKERHUB_TOKEN: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
          DOCKERHUB_USERNAME: {{ docker_login_username | tojson }}
          DOCKERHUB_NAMESPACE: {{ docker_registry | tojson }}
          DOCKERHUB_REPOSITORY: {{ docker_image_name | tojson }}
{%- endif %}
          TAG: {{ '${{ steps.version.outputs.version }}' }}
          TAG_EXISTS: {{ '${{ steps.release-state.outputs.tag_exists }}' }}
        run: |
          set -euo pipefail

{%- if use_aws_ecr %}
          IMAGE_RESPONSE="$(mktemp)"
          trap 'rm -f "$IMAGE_RESPONSE"' EXIT
          if ! aws ecr batch-get-image \
            --registry-id "$ECR_REGISTRY_ID" \
            --repository-name "$ECR_REPOSITORY" \
            --image-ids imageTag="$TAG" imageTag=latest \
            --output json > "$IMAGE_RESPONSE"; then
            echo "::error::Could not inspect ECR image tags."
            exit 1
          fi

          if jq -e '.failures[]? | select(.failureCode != "ImageNotFound")' "$IMAGE_RESPONSE" >/dev/null; then
            echo "::error::ECR returned an unexpected image lookup failure."
            exit 1
          fi

          read_digest() {
            local image_tag="$1"
            local match_count
            match_count="$(
              jq -r --arg tag "$image_tag" \
                '[.images[]? | select(.imageId.imageTag == $tag)] | length' \
                "$IMAGE_RESPONSE"
            )"
            if [ "$match_count" -eq 0 ]; then
              local missing_count
              missing_count="$(
                jq -r --arg tag "$image_tag" \
                  '[.failures[]? | select(.imageId.imageTag == $tag and .failureCode == "ImageNotFound")] | length' \
                  "$IMAGE_RESPONSE"
              )"
              if [ "$missing_count" -eq 1 ]; then
                return 0
              fi
              echo "::error::ECR returned no verifiable state for tag $image_tag." >&2
              return 1
            fi
            if [ "$match_count" -ne 1 ]; then
              echo "::error::ECR returned multiple images for tag $image_tag." >&2
              return 1
            fi
            jq -er --arg tag "$image_tag" \
              '.images[] | select(.imageId.imageTag == $tag) | .imageId.imageDigest | select(type == "string" and test("^sha256:[0-9a-f]{64}$"))' \
              "$IMAGE_RESPONSE"
          }
{%- else %}
          AUTH_RESPONSE="$(mktemp)"
          trap 'rm -f "$AUTH_RESPONSE"' EXIT
          AUTH_PAYLOAD="$(
            jq -cn \
              --arg identifier "$DOCKERHUB_USERNAME" \
              --arg secret "$DOCKERHUB_TOKEN" \
              '{identifier: $identifier, secret: $secret}'
          )"

          set +e
          AUTH_HTTP_STATUS="$(
            curl --silent --show-error --location \
              --output "$AUTH_RESPONSE" \
              --write-out '%{http_code}' \
              --header 'Content-Type: application/json' \
              --data "$AUTH_PAYLOAD" \
              https://hub.docker.com/v2/auth/token
          )"
          CURL_STATUS=$?
          set -e

          if [ "$CURL_STATUS" -ne 0 ]; then
            echo "::error::Could not authenticate with the Docker Hub API."
            exit "$CURL_STATUS"
          fi
          if [ "$AUTH_HTTP_STATUS" != "200" ]; then
            echo "::error::Could not authenticate with the Docker Hub API: HTTP $AUTH_HTTP_STATUS."
            exit 1
          fi

          if ! DOCKERHUB_API_TOKEN="$(
            jq -er '.access_token | select(type == "string" and length > 0)' \
              "$AUTH_RESPONSE"
          )"; then
            echo "::error::Docker Hub authentication response did not contain an access token."
            exit 1
          fi
          echo "::add-mask::$DOCKERHUB_API_TOKEN"

          read_digest() {
            local image_tag="$1"
            local response_file
            local http_status
            local curl_status
            local digest
            response_file="$(mktemp)"

            set +e
            http_status="$(
              curl --silent --show-error --location \
                --output "$response_file" \
                --write-out '%{http_code}' \
                --header "Authorization: Bearer $DOCKERHUB_API_TOKEN" \
                "https://hub.docker.com/v2/repositories/$DOCKERHUB_NAMESPACE/$DOCKERHUB_REPOSITORY/tags/$image_tag"
            )"
            curl_status=$?
            set -e

            if [ "$curl_status" -ne 0 ]; then
              rm -f "$response_file"
              echo "::error::Could not inspect Docker Hub image tag $image_tag." >&2
              return "$curl_status"
            fi

            case "$http_status" in
              200)
                if ! digest="$(
                  jq -er \
                    'def valid_digest:
                       type == "string" and test("^sha256:[0-9a-f]{64}$");
                     if has("digest") then
                       .digest
                       | select(valid_digest)
                     elif (.images | type) == "array"
                       and (.images | length) > 0
                       and all(.images[].digest; valid_digest)
                     then
                       [.images[].digest] | unique | sort | .[]
                     else
                       error("Docker Hub tag response did not contain valid image digests")
                     end' \
                    "$response_file"
                )"; then
                  rm -f "$response_file"
                  return 1
                fi
                rm -f "$response_file"
                printf '%s\n' "$digest"
                ;;
              404)
                rm -f "$response_file"
                ;;
              *)
                rm -f "$response_file"
                echo "::error::Could not inspect Docker Hub image tag $image_tag: HTTP $http_status." >&2
                return 1
                ;;
            esac
          }
{%- endif %}

          if ! VERSION_DIGEST="$(read_digest "$TAG")"; then
            echo "::error::Could not resolve a valid digest for image tag $TAG."
            exit 1
          fi
          if ! LATEST_DIGEST="$(read_digest latest)"; then
            echo "::error::Could not resolve a valid digest for image tag latest."
            exit 1
          fi

          version_exists=false
          latest_exists=false
          latest_matches=false
          if [ -n "$VERSION_DIGEST" ]; then
            version_exists=true
          fi
          if [ -n "$LATEST_DIGEST" ]; then
            latest_exists=true
          fi
          if [ "$version_exists" = "true" ] \
            && [ "$latest_exists" = "true" ] \
            && [ "$VERSION_DIGEST" = "$LATEST_DIGEST" ]; then
            latest_matches=true
          fi

          {
            echo "version_exists=$version_exists"
            echo "latest_exists=$latest_exists"
            echo "latest_matches=$latest_matches"
          } >> "$GITHUB_OUTPUT"

      - name: Verify Docker image ownership
        if: steps.release-state.outputs.tag_exists != 'true' && steps.image-state.outputs.version_exists == 'true'
        env:
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: bash .github/scripts/manage-docker-image-owner.sh verify "$TAG"

      - name: Set up Docker Buildx
        if: steps.image-state.outputs.version_exists != 'true'
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4.2.0

{%- if use_aws_ecr %}
      - name: Login to Amazon ECR
        if: steps.image-state.outputs.version_exists != 'true'
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@d539f0932e70871a027e9d5a9d8fc38589180a64 # v2.1.6
{%- else %}
      - name: Login to Docker Hub
        if: steps.image-state.outputs.version_exists != 'true'
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          username: {{ docker_login_username | tojson }}
          password: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{%- endif %}

      - name: Record Docker image ownership
        if: steps.image-state.outputs.version_exists != 'true'
        env:
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: bash .github/scripts/manage-docker-image-owner.sh record "$TAG"

      - name: Build and push
        if: steps.image-state.outputs.version_exists != 'true'
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7.3.0
        with:
          context: .
          push: true
          tags: |
            {{ docker_registry }}/{{ docker_image_name }}:{{ '${{ steps.version.outputs.version }}' }}

      - name: Configure Git
        if: steps.release-state.outputs.tag_exists != 'true'
        env:
          GIT_USER_NAME: {{ author_name | tojson }}
          GIT_USER_EMAIL: {{ author_email | tojson }}
        run: |
          git config user.name "$GIT_USER_NAME"
          git config user.email "$GIT_USER_EMAIL"

      - name: Create version tag
        if: steps.release-state.outputs.tag_exists != 'true'
        env:
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: |
          git tag -a "$TAG" -m "Release $TAG"
          git push origin "refs/tags/$TAG"

      - name: Release Docker image ownership
        env:
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: bash .github/scripts/manage-docker-image-owner.sh release "$TAG"

      - name: Create GitHub Release
        if: steps.release-state.outputs.release_exists != 'true'
        env:
          GH_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}
          TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: |
          gh release create "$TAG" \
            --latest=false \
            --title "Release $TAG" \
            --notes "## Docker Image

          Pull the Docker image:

          \`\`\`bash
{%- if use_aws_ecr %}
          aws ecr get-login-password --region {{ aws_region }} | \
            docker login --username AWS --password-stdin {{ aws_account_id }}.dkr.ecr.{{ aws_region }}.amazonaws.com
{%- endif %}
          docker pull {{ docker_registry }}/{{ docker_image_name }}:$TAG
          \`\`\`

          ## Links:

{%- if use_aws_ecr %}
          - [ECR](https://{{ aws_region }}.console.aws.amazon.com/ecr/repositories/private/{{ aws_account_id }}/{{ docker_image_name }}/_/details?region={{ aws_region }})
{%- else %}
          - [Docker Hub](https://hub.docker.com/r/{{ docker_registry }}/{{ docker_image_name }})
{%- endif %}
          - [Source Code]({{ '${{ github.server_url }}/${{ github.repository }}/tree/' }}$TAG)
          "

      - name: Record latest release
        env:
          IMAGE_TAG: {{ '${{ steps.version.outputs.version }}' }}
          RELEASE_TAG: {{ '${{ steps.version.outputs.version }}' }}
        run: bash .github/scripts/authorize-docker-latest.sh record

  promote-latest:
    needs: docker-release
    concurrency:
      group: docker-latest
      cancel-in-progress: false
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - name: Read latest release
        id: latest-state
        run: bash .github/scripts/authorize-docker-latest.sh read

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4.2.0

{%- if use_aws_ecr %}
      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@e6de054238d6b7531b4efff3b6587d9aade6a06c # v6.2.3
        with:
          role-to-assume: {{ '${{ secrets.AWS_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}

      - name: Login to Amazon ECR
        uses: aws-actions/amazon-ecr-login@d539f0932e70871a027e9d5a9d8fc38589180a64 # v2.1.6
{%- else %}
      - name: Login to Docker Hub
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          username: {{ docker_login_username | tojson }}
          password: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{%- endif %}

      - name: Publish latest tag
        env:
          IMAGE_REPOSITORY: {{ (docker_registry ~ '/' ~ docker_image_name) | tojson }}
          TAG: {{ '${{ steps.latest-state.outputs.image_tag }}' }}
        run: |
          set -euo pipefail
          docker buildx imagetools create \
            --prefer-index=false \
            --tag "$IMAGE_REPOSITORY:latest" \
            "$IMAGE_REPOSITORY:$TAG"

      - name: Mark GitHub Release as latest
        env:
          GH_TOKEN: {{ '${{ secrets.GITHUB_TOKEN }}' }}
          TAG: {{ '${{ steps.latest-state.outputs.release_tag }}' }}
        run: gh release edit "$TAG" --latest
