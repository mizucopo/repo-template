{% from "_action_pins.yml.jinja" import action %}name: PR Quality Checks

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  quality-checks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: {{ action('actions/checkout') }}

      - name: Set up Python
        id: setup-python
        uses: {{ action('actions/setup-python') }}
        with:
          python-version-file: {{ '.python-version' | tojson }}

      - uses: {{ action('astral-sh/setup-uv') }}
        with:
          enable-cache: false

      - name: Install dependencies
        run: uv sync --locked

      - name: Run quality gate
        timeout-minutes: 15
        run: uv run task check
