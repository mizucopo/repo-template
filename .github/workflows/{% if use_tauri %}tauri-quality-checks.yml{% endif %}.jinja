name: Tauri Quality Checks

{% if use_gh_actions_merge_preparation %}{% include '_merge_ci_header.yml.jinja' %}{% else %}on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

{% endif %}jobs:
{% if use_gh_actions_merge_preparation %}{% include '_merge_ci_control.yml.jinja' %}
{% endif %}  tauri-quality-checks:
{% if use_gh_actions_merge_preparation %}    needs: control
    defaults:
      run:
        working-directory: candidate
{% endif %}    runs-on: ubuntu-latest
    steps:
{% if use_gh_actions_merge_preparation %}{% include '_merge_ci_checkout.yml.jinja' %}{% else %}      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

{% endif %}
      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version-file: {{ ('candidate/.node-version' if use_gh_actions_merge_preparation else '.node-version') | tojson }}

      - name: Install Rust toolchain
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py candidate-command --root ../trusted-control --candidate . --command {% endif %}rustup show

      - name: Install Tauri Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libayatana-appindicator3-dev \
            librsvg2-dev \
            libwebkit2gtk-4.1-dev \
            libgtk-3-dev \
            libxdo-dev

      - name: Install dependencies
        run: |
{% if use_gh_actions_merge_preparation %}          python3 -I ../trusted-control/.github/scripts/merge-preparation.py candidate-command --root ../trusted-control --candidate . --command bash -euc '
{% endif %}
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi
{% if use_gh_actions_merge_preparation %}          '
{% endif %}

      - name: Run Oxlint
        id: oxlint
        continue-on-error: true
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name lint{% else %}npm run lint{% endif %}

      - name: Run Prettier check
        id: prettier
        continue-on-error: true
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name format:check{% else %}npm run format:check{% endif %}

      - name: Run TypeScript typecheck
        id: typecheck
        continue-on-error: true
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name typecheck{% else %}npm run typecheck{% endif %}

      - name: Run Vitest
        id: vitest
        continue-on-error: true
        timeout-minutes: 10
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name test:run{% else %}npm run test:run{% endif %}

      - name: Run frontend build
        id: frontend-build
        continue-on-error: true
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name build{% else %}npm run build{% endif %}

      - name: Run rustfmt check
        id: rustfmt
        continue-on-error: true
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name cargo:fmt{% else %}npm run cargo:fmt{% endif %}

      - name: Run Clippy
        id: clippy
        continue-on-error: true
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name cargo:clippy{% else %}npm run cargo:clippy{% endif %}

      - name: Run cargo test
        id: cargo-test
        continue-on-error: true
        timeout-minutes: 10
        run: {% if use_gh_actions_merge_preparation %}python3 -I ../trusted-control/.github/scripts/merge-preparation.py npm-script --root ../trusted-control --candidate . --name cargo:test{% else %}npm run cargo:test{% endif %}

      - name: Build Tauri quality check summary
        id: tauri-quality-report
        if: {{ '${{ !cancelled() }}' }}
        env:
          OXLINT_OUTCOME: {{ '${{ steps.oxlint.outcome }}' }}
          PRETTIER_OUTCOME: {{ '${{ steps.prettier.outcome }}' }}
          TYPECHECK_OUTCOME: {{ '${{ steps.typecheck.outcome }}' }}
          VITEST_OUTCOME: {{ '${{ steps.vitest.outcome }}' }}
          FRONTEND_BUILD_OUTCOME: {{ '${{ steps.frontend-build.outcome }}' }}
          RUSTFMT_OUTCOME: {{ '${{ steps.rustfmt.outcome }}' }}
          CLIPPY_OUTCOME: {{ '${{ steps.clippy.outcome }}' }}
          CARGO_TEST_OUTCOME: {{ '${{ steps.cargo-test.outcome }}' }}
        run: |
          format_result() {
            case "$1" in
              success) printf '✅ 成功' ;;
              failure) printf '❌ 失敗' ;;
              skipped) printf '⏭️ スキップ' ;;
              *) printf '❓ %s' "${1:-unknown}" ;;
            esac
          }

          cat > tauri_quality_report.md <<EOF
          ## Tauri Quality Checks Result

          | Item | Result |
          |-------------|------|
          | Oxlint | $(format_result "$OXLINT_OUTCOME") |
          | Prettier | $(format_result "$PRETTIER_OUTCOME") |
          | TypeScript | $(format_result "$TYPECHECK_OUTCOME") |
          | Vitest | $(format_result "$VITEST_OUTCOME") |
          | Frontend build | $(format_result "$FRONTEND_BUILD_OUTCOME") |
          | rustfmt | $(format_result "$RUSTFMT_OUTCOME") |
          | Clippy | $(format_result "$CLIPPY_OUTCOME") |
          | cargo test | $(format_result "$CARGO_TEST_OUTCOME") |
          EOF

          cat tauri_quality_report.md >> "$GITHUB_STEP_SUMMARY"

          HAS_FAILURE=false
          for outcome in \
            "$OXLINT_OUTCOME" \
            "$PRETTIER_OUTCOME" \
            "$TYPECHECK_OUTCOME" \
            "$VITEST_OUTCOME" \
            "$FRONTEND_BUILD_OUTCOME" \
            "$RUSTFMT_OUTCOME" \
            "$CLIPPY_OUTCOME" \
            "$CARGO_TEST_OUTCOME"; do
            if [ "$outcome" != "success" ]; then
              HAS_FAILURE=true
            fi
          done
          echo "has-failure=$HAS_FAILURE" >> "$GITHUB_OUTPUT"

      - name: Enforce quality gate result
        if: {{ "${{ !cancelled() && steps.tauri-quality-report.outputs.has-failure == 'true' }}" }}
        run: |
          echo "::error::One or more Tauri quality checks failed or were skipped."
          exit 1
