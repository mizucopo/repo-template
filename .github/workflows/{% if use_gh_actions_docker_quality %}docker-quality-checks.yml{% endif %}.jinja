{% set normalized_dockerfile_path = dockerfile_path | replace("\\", "/") -%}
{% set normalized_docker_build_context = docker_build_context | replace("\\", "/") -%}
name: Docker Quality Checks

{% if use_gh_actions_merge_preparation %}{% include '_merge_ci_header.yml.jinja' %}{% else %}on:
  pull_request:

permissions:
  contents: read

{% endif %}jobs:
{% if use_gh_actions_merge_preparation %}{% include '_merge_ci_control.yml.jinja' %}
{% endif %}  docker-quality-checks:
{% if use_gh_actions_merge_preparation %}    needs: control
    defaults:
      run:
        working-directory: candidate
{% endif %}    runs-on: ubuntu-latest
    env:
      DOCKERFILE_PATH: {{ normalized_dockerfile_path | tojson }}
      DOCKER_BUILD_CONTEXT: {{ normalized_docker_build_context | tojson }}
      LOCAL_IMAGE: repo-template-smoke:{{ '${{ github.sha }}' }}
      DOCKER_SMOKE_COMMAND: {{ docker_smoke_command | tojson }}
    steps:
{% if use_gh_actions_merge_preparation %}{% include '_merge_ci_checkout.yml.jinja' %}{% else %}      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
{% endif %}
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4.2.0
      - name: Run Docker build checks
        run: docker buildx build --check --file "$DOCKERFILE_PATH" "$DOCKER_BUILD_CONTEXT"
      - name: Build Docker image
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7.3.0
        with:
          context: {{ (('candidate/' if use_gh_actions_merge_preparation else '') ~ normalized_docker_build_context) | tojson }}
          file: {{ (('candidate/' if use_gh_actions_merge_preparation else '') ~ normalized_dockerfile_path) | tojson }}
          load: true
          push: false
          tags: {{ '${{ env.LOCAL_IMAGE }}' }}
      - name: Run Docker smoke test
        if: {{ "${{ env.DOCKER_SMOKE_COMMAND != '' }}" }}
        run: docker run --rm --entrypoint sh "$LOCAL_IMAGE" -eu -c "$DOCKER_SMOKE_COMMAND"
