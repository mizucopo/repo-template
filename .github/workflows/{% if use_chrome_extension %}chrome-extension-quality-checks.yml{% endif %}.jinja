{% from "_action_pins.yml.jinja" import action %}name: Chrome Extension Quality Checks

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  chrome-extension-quality-checks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: {{ action('actions/checkout') }}

      - name: Set up Node.js
        uses: {{ action('actions/setup-node') }}
        with:
          node-version-file: {{ '.node-version' | tojson }}

      - name: Install dependencies
        run: |

          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Run quality gate
        timeout-minutes: 15
        run: npm run check
