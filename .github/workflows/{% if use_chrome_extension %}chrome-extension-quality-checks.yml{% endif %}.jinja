name: Chrome Extension Quality Checks

on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read
  checks: write

jobs:
  chrome-extension-quality-checks:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: ".node-version"
          cache: npm

      - name: Install dependencies
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Run ESLint
        id: eslint
        continue-on-error: true
        run: |
          if npm run lint > eslint_output.txt 2>&1; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Run Prettier check
        id: prettier
        continue-on-error: true
        run: |
          if npm run format:check > prettier_output.txt 2>&1; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Run TypeScript typecheck
        id: typecheck
        continue-on-error: true
        run: |
          if npm run typecheck > typecheck_output.txt 2>&1; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Run Vitest
        id: vitest
        continue-on-error: true
        timeout-minutes: 10
        run: |
          npm run test:run 2>&1 | tee vitest_output.txt
          VITEST_EXIT=${PIPESTATUS[0]}
          if [ "$VITEST_EXIT" -eq 0 ]; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗 (終了コード: $VITEST_EXIT)"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Run extension build
        id: build
        continue-on-error: true
        run: |
          if npm run build > build_output.txt 2>&1; then
            RESULT="✅ 成功"
          else
            RESULT="❌ 失敗"
          fi
          echo "result=$RESULT" >> "$GITHUB_OUTPUT"

      - name: Build Chrome extension quality check summary
        id: chrome-quality-report
        if: always()
        run: |
          cat > chrome_quality_report.md <<'EOF'
          ## Chrome Extension Quality Checks Result

          | Item | Result |
          |-------------|------|
          | ESLint | {{ '${{ steps.eslint.outputs.result }}' }} |
          | Prettier | {{ '${{ steps.prettier.outputs.result }}' }} |
          | TypeScript | {{ '${{ steps.typecheck.outputs.result }}' }} |
          | Vitest | {{ '${{ steps.vitest.outputs.result }}' }} |
          | Build | {{ '${{ steps.build.outputs.result }}' }} |
          EOF

          cat chrome_quality_report.md >> "$GITHUB_STEP_SUMMARY"

          {
            echo "summary<<EOF"
            cat chrome_quality_report.md
            echo "EOF"
          } >> "$GITHUB_OUTPUT"

      - name: Publish Chrome extension quality check
        if: always() && github.event_name == 'pull_request' && github.event.pull_request.head.repo.fork == false
        uses: actions/github-script@v7
        continue-on-error: true
        env:
          SUMMARY: {{ '${{ steps.chrome-quality-report.outputs.summary }}' }}
          ESLINT_RESULT: {{ '${{ steps.eslint.outputs.result }}' }}
          PRETTIER_RESULT: {{ '${{ steps.prettier.outputs.result }}' }}
          TYPECHECK_RESULT: {{ '${{ steps.typecheck.outputs.result }}' }}
          VITEST_RESULT: {{ '${{ steps.vitest.outputs.result }}' }}
          BUILD_RESULT: {{ '${{ steps.build.outputs.result }}' }}
        with:
          script: |
            const results = [
              process.env.ESLINT_RESULT,
              process.env.PRETTIER_RESULT,
              process.env.TYPECHECK_RESULT,
              process.env.VITEST_RESULT,
              process.env.BUILD_RESULT,
            ];
            const allPassed = results.every((result) => result?.includes("成功"));

            let checkConclusion = "neutral";
            let checkTitle = "Chrome extension quality checks need attention";
            if (allPassed) {
              checkConclusion = "success";
              checkTitle = "All Chrome extension quality checks passed";
            }

            await github.rest.checks.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              name: "Chrome Extension Quality Checks Result",
              head_sha: context.payload.pull_request.head.sha,
              status: "completed",
              conclusion: checkConclusion,
              output: {
                title: checkTitle,
                summary: process.env.SUMMARY,
              },
            });
