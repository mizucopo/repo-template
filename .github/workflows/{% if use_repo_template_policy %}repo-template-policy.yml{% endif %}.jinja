{% from "_action_pins.yml.jinja" import action %}name: Repository Template Policy

on:
  pull_request:

permissions:
  contents: read

jobs:
  repo-template-policy:
    runs-on: ubuntu-latest
    timeout-minutes: 12
    steps:
      - name: Check out trusted base
        uses: {{ action('actions/checkout') }}
        with:
          ref: {% raw %}${{ github.event.pull_request.base.sha }}{% endraw %}
          path: trusted-base
          persist-credentials: false
      - name: Check out proposed merge tree as data
        uses: {{ action('actions/checkout') }}
        with:
          ref: {% raw %}${{ github.sha }}{% endraw %}
          path: candidate
          persist-credentials: false
      - name: Check out canonical template history
        uses: {{ action('actions/checkout') }}
        with:
          repository: mizucopo/repo-template
          ref: main
          fetch-depth: 0
          path: canonical-template
          persist-credentials: false
      - name: Set up policy runtime
        uses: {{ action('actions/setup-python') }}
        with:
          python-version: "3.14"
      - name: Install Copier
        run: python -m pip install copier==9.17.1
      - name: Check policy on committed files
        shell: bash
        run: |
          if ! git -C trusted-base cat-file -e 'HEAD:.github/scripts/check-template-policy.py'; then
            echo "Initial adoption: review the policy, then enable the check after merge."
            exit 0
          fi
          python trusted-base/.github/scripts/check-template-policy.py \
            --base trusted-base --head candidate --template canonical-template
