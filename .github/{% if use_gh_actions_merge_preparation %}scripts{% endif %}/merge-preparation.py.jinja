#!/usr/bin/env python3
"""Base-owned release preparation. PR objects are data, never executable inputs.

H0 is the input before bot updates; H1 is the resulting PR head. The signed
projection is merge(B, H1), excluding only PLAN. It does not contain H1's SHA.
Check Runs are disposable views; release recovery uses the signed Git record.
"""

import argparse
import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path
from urllib import error, parse, request

POLICY = ".github/merge-preparation.json"
PLAN = ".github/release-plan.json"
SCRIPT = ".github/scripts/merge-preparation.py"
CHECK = "マージ準備"
DOMAIN = b"repo-template/release-plan/v1\n"
LEVELS = {"patch", "minor", "major"}
SHA = re.compile(r"[0-9a-f]{40}\Z")
SEMVER = re.compile(
    r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
    r"(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)"
    r"(?:\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?"
    r"(?:\+([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?\Z"
)


class PreparationError(Exception):
    """A condition requires attention; never silently relax the contract."""


def require(condition, message):
    if not condition:
        raise PreparationError(message)


def canonical(value):
    return json.dumps(value, sort_keys=True, ensure_ascii=True, separators=(",", ":")).encode()


def digest(value):
    return hashlib.sha256(canonical(value)).hexdigest()


def run(*args, data=None, env=None, cwd=None):
    result = subprocess.run(args, input=data, capture_output=True, cwd=cwd, env=env)
    require(result.returncode == 0, f"{args[0]} failed: {result.stderr.decode(errors='replace')[:1000]}")
    return result.stdout


def output(name, value):
    value = str(value)
    require("\n" not in value and "\r" not in value, f"Invalid output: {name}")
    if os.environ.get("GITHUB_OUTPUT"):
        with open(os.environ["GITHUB_OUTPUT"], "a") as stream:
            stream.write(f"{name}={value}\n")


def safe_path(path):
    require(isinstance(path, str) and path and not path.startswith(("/", "-"))
            and "\\" not in path and not any(c in path for c in "\r\n\0")
            and all(part not in {".", "..", ""} for part in path.split("/")),
            f"Invalid repository path: {path!r}")
    return path


def candidate_command(control, candidate, command, resolver="/etc/resolv.conf"):
    """Candidate processes cannot mutate B, runner state or host services."""
    require(sys.platform == "linux" and shutil.which("bwrap"),
            "Candidate isolation requires Linux bubblewrap/user namespaces; install bubblewrap and retry")
    control, candidate = Path(control).resolve(), Path(candidate).resolve()
    require(control != candidate and control not in candidate.parents and candidate not in control.parents,
            "Trusted control and candidate directories must be separate")
    cache = Path(os.environ["RUNNER_TEMP"]) / "merge-candidate-home"
    cache.mkdir(exist_ok=True)
    args = ["bwrap", "--unshare-user", "--unshare-pid", "--unshare-ipc", "--unshare-uts",
            "--new-session", "--die-with-parent", "--cap-drop", "ALL", "--clearenv"]
    # Build an allowlisted filesystem. In particular, do not mount host /run,
    # /tmp, workspace siblings, runner command files, or the Docker socket.
    home = Path.home()
    readonly_paths = [Path(p) for p in ("/usr", "/bin", "/sbin", "/lib", "/lib64", "/etc", "/opt")]
    readonly_paths.extend(home / p for p in (".cargo", ".rustup", ".local"))
    for path in readonly_paths:
        if path.exists():
            args.extend(["--ro-bind", str(path), str(path)])
    # Ubuntu often links resolv.conf into /run. Expose only its resolved file,
    # keeping host service sockets hidden while dependency downloads use DNS.
    resolver = Path(resolver).resolve(strict=True)
    args.extend(["--tmpfs", "/tmp", "--ro-bind", str(resolver), str(resolver),
                 "--ro-bind", str(control), str(control), "--bind", str(candidate), str(candidate),
                 "--bind", str(cache), "/candidate-home", "--proc", "/proc", "--dev", "/dev",
                 "--setenv", "PATH", os.environ["PATH"], "--setenv", "HOME", "/candidate-home",
                 "--setenv", "CARGO_HOME", "/candidate-home/.cargo",
                 "--setenv", "RUSTUP_HOME", "/candidate-home/.rustup",
                 "--setenv", "CI", "true", "--setenv", "LANG", "C.UTF-8"])
    # setup-python's shared libraries/build metadata are trusted tool inputs.
    for name in ("LD_LIBRARY_PATH", "PKG_CONFIG_PATH", "pythonLocation", "Python_ROOT_DIR", "Python3_ROOT_DIR"):
        if os.environ.get(name):
            args.extend(["--setenv", name, os.environ[name]])
    args.extend(["--chdir", str(candidate), "--", *command])
    return subprocess.run(args, stdin=subprocess.DEVNULL).returncode


def version_key(version, scheme):
    if scheme == "chrome":
        require(isinstance(version, str) and re.fullmatch(r"(?:0|[1-9][0-9]*)(?:\.(?:0|[1-9][0-9]*)){0,3}", version),
                f"Invalid Chrome version: {version}")
        parts = list(map(int, version.split(".")))
        require(any(parts) and max(parts) <= 65535, f"Chrome version out of range: {version}")
        return tuple(parts + [0] * (4 - len(parts)))
    match = SEMVER.fullmatch(version) if isinstance(version, str) else None
    require(match, f"Invalid SemVer: {version}")
    core = tuple(map(int, match.groups()[:3]))
    pre = match.group(4)
    # Numeric identifiers precede nonnumeric identifiers; stable follows prerelease.
    if pre is None:
        return core, 1, ()
    identifiers = tuple(
        (0, int(item)) if item.isdigit() else (1, item) for item in pre.split(".")
    )
    return core, 0, identifiers


def bump(version, level, scheme):
    require(level in LEVELS, f"Unsupported release level: {level}")
    version_key(version, scheme)
    if scheme == "chrome":
        parts = list(map(int, version.split(".")))
        parts += [0] * max(0, 3 - len(parts))
        index = {"major": 0, "minor": 1, "patch": len(parts) - 1}[level]
        parts[index] += 1
        require(parts[index] <= 65535, f"Chrome {level} component exceeds 65535: {version}")
        for i in range(index + 1, len(parts)):
            parts[i] = 0
        return ".".join(map(str, parts))
    match = SEMVER.fullmatch(version)
    parts = list(map(int, match.groups()[:3]))
    if match.group(4) and level == "patch":
        identifiers = match.group(4).split(".")
        require(identifiers[-1].isdigit(), "Prerelease needs an explicit numeric channel sequence")
        identifiers[-1] = str(int(identifiers[-1]) + 1)
        return ".".join(map(str, parts)) + "-" + ".".join(identifiers)
    index = {"major": 0, "minor": 1, "patch": 2}[level]
    parts[index] = 1 if level == "major" and parts[0] == 0 else parts[index] + 1
    for i in range(index + 1, 3):
        parts[i] = 0
    return ".".join(map(str, parts))


def revision_number(value):
    require(isinstance(value, str) and re.fullmatch(r"r(?:0|[1-9][0-9]*)", value),
            f"Invalid revision: {value!r}; expected rN")
    return int(value[1:])


def publication(policy, version, revision=None):
    context = {"version": version, "revision": revision or "r0",
               "revision_suffix": "" if revision in (None, "r0") else f"-{revision}"}
    spec = policy["publication"]
    try:
        tag = spec["release_tag"].format_map(context)
        images = [{**image, "tag": image["tag"].format_map(context)} for image in spec["images"]]
    except (KeyError, ValueError) as exc:
        raise PreparationError(f"Invalid publication tag template: {exc}") from exc
    run("git", "check-ref-format", f"refs/tags/{tag}")
    for image in images:
        require(re.fullmatch(r"[a-z0-9][a-z0-9_-]*", image["name"]) and image["name"] != "release_tag",
                f"Invalid/reserved publication setting name: {image['name']}")
        require(re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", image["tag"])
                and image["tag"] not in image.get("aliases", []) and image["tag"] != "latest",
                f"Invalid immutable image tag: {image['name']}")
        run("git", "check-ref-format", f"refs/heads/automation/docker-images/{image['tag']}")
    require(len({(i["repository"], i["tag"]) for i in images}) == len(images),
            "Duplicate immutable image tags")
    require(len({i["name"] for i in images}) == len(images), "Duplicate publication setting names")
    require(spec.get("latest_image") is None or spec["latest_image"] in {i["name"] for i in images}, "latest_image does not name a declared image")
    return {"release_tag": tag, "images": images,
            "release_paths": spec["release_paths"], "latest_image": spec.get("latest_image"),
            "github_release": spec["github_release"]}


def choose(policy, base_version, level, explicit_minimum, occupied,
           base_revision=None, input_version=None, explicit_revision=None, previous=None):
    scheme = policy["version"]["scheme"]
    if scheme == "upstream-revision":
        version = input_version or base_version
        precedence = version_key(version, "semver")
        base_precedence = version_key(base_version, "semver")
        require(precedence >= base_precedence, "Upstream version would decrease")
        floor = revision_number(base_revision or "r0") + 1 if precedence == base_precedence else 0
        if explicit_revision is not None:
            require(revision_number(explicit_revision) >= floor, "Explicit revision does not meet required increment")
            floor = revision_number(explicit_revision)
        revision = f"r{floor}"
        if previous and previous[0] == version and revision_number(previous[1]) >= floor:
            revision = previous[1]
    else:
        if scheme == "semver" and SEMVER.fullmatch(base_version).group(4) and level != "patch":
            require(explicit_minimum is not None, "Prerelease core/stable transition needs an explicit version minimum")
        version = bump(base_version, level, scheme)
        if explicit_minimum is not None:
            require(version_key(explicit_minimum, scheme) >= version_key(version, scheme),
                    f"Explicit minimum {explicit_minimum} does not meet {level} increment from {base_version}")
            version = explicit_minimum
        revision = None
        if previous and version_key(previous[0], scheme) >= version_key(version, scheme):
            version = previous[0]
    for _ in range(100):
        plan = publication(policy, version, revision)
        collisions = occupied(plan)
        if not collisions:
            return version, revision, plan
        next_version, next_revision = (version, f"r{revision_number(revision) + 1}") if revision is not None else (bump(version, "patch", scheme), None)
        next_plan = publication(policy, next_version, next_revision)
        objects = {"release_tag": lambda p: p["release_tag"], **{
            image["name"]: lambda p, name=image["name"]: next(i["tag"] for i in p["images"] if i["name"] == name)
            for image in plan["images"]}}
        for name in collisions:
            require(name in objects, f"Unknown collision target: {name}")
            require(objects[name](plan) != objects[name](next_plan),
                    f"Publication setting {name} cannot advance its colliding tag")
        version, revision = next_version, next_revision
    raise PreparationError("No unused version after 100 candidates; inspect publication settings")


def get_field(data, keys):
    for key in keys:
        data = data[key]
    return data


def read_field(blob, spec):
    text = blob.decode()
    if spec["format"] == "text":
        require(len(text.strip().splitlines()) == 1, f"Expected one version line: {spec['path']}")
        return text.strip()
    data = json.loads(text) if spec["format"] == "json" else tomllib.loads(text)
    if spec["format"] == "toml-lock":
        packages = [p for p in data.get("package", []) if p.get("name") == spec["package"]]
        require(len(packages) == 1, f"Missing or ambiguous root package in {spec['path']}")
        return packages[0]["version"]
    return get_field(data, spec["key"])


def write_field(blob, spec, value):
    old = read_field(blob, spec)
    if old == value:
        return blob
    if spec["format"] == "text":
        return (value + "\n").encode()
    if spec["format"] == "json":
        data = json.loads(blob)
        parent = get_field(data, spec["key"][:-1])
        parent[spec["key"][-1]] = value
        return (json.dumps(data, indent=2, ensure_ascii=False) + "\n").encode()
    text = blob.decode()
    if spec["format"] == "toml-lock":
        chunks = re.split(r"(?=^\[\[package\]\]\s*$)", text, flags=re.M)
        candidates = [i for i, chunk in enumerate(chunks) if re.search(
            r'^name\s*=\s*"' + re.escape(spec["package"]) + r'"\s*$', chunk, re.M)]
        require(len(candidates) == 1, f"Ambiguous lock package: {spec['path']}")
        i = candidates[0]
        chunks[i], count = re.subn(r'^version\s*=\s*"[^"\n]*"', f'version = "{value}"', chunks[i], count=1, flags=re.M)
        text = "".join(chunks)
    else:
        section = ".".join(spec["key"][:-1])
        pattern = r"(^\[" + re.escape(section) + r"\][^\n]*\n)(.*?)(?=^\[|\Z)"
        match = re.search(pattern, text, re.M | re.S)
        require(match, f"Missing version table: {spec['path']}")
        body, count = re.subn(r'^' + re.escape(spec["key"][-1]) + r'\s*=\s*"[^"\n]*"',
                             f'{spec["key"][-1]} = "{value}"', match.group(2), count=1, flags=re.M)
        text = text[:match.start(2)] + body + text[match.end(2):]
    require(count == 1 and read_field(text.encode(), spec) == value, f"Cannot safely update {spec['path']}")
    # Parsing before/after and restoring the old value proves no other TOML data changed.
    before, after = tomllib.loads(blob.decode()), tomllib.loads(text)
    if spec["format"] == "toml-lock":
        next(p for p in after["package"] if p["name"] == spec["package"])["version"] = old
    else:
        get_field(after, spec["key"][:-1])[spec["key"][-1]] = old
    require(before == after, f"Unexpected TOML changes in {spec['path']}")
    return text.encode()


class Git:
    def __init__(self, root="."):
        self.root = str(Path(root).resolve())

    def command(self, *args, data=None, env=None):
        return run("git", "-c", "core.hooksPath=/dev/null", "-C", self.root, *args, data=data, env=env)

    def text(self, *args):
        return self.command(*args).decode().strip()

    def entries(self, tree):
        result = {}
        for line in self.command("ls-tree", "-rz", tree).split(b"\0"):
            if not line:
                continue
            header, path = line.split(b"\t", 1)
            mode, kind, oid = header.decode().split()
            result[path.decode()] = (mode, kind, oid)
        return result

    def blob(self, tree, path, optional=False):
        entry = self.entries(tree).get(safe_path(path))
        if entry is None and optional:
            return None
        require(entry and entry[0] in {"100644", "100755"} and entry[1] == "blob",
                f"Missing regular data file: {path} at {tree}")
        return self.command("cat-file", "blob", entry[2])

    def patch_tree(self, tree, changes):
        with tempfile.TemporaryDirectory() as directory:
            env = {**os.environ, "GIT_INDEX_FILE": str(Path(directory) / "index")}
            self.command("read-tree", tree, env=env)
            for path, data in changes.items():
                safe_path(path)
                if data is None:
                    self.command("update-index", "--force-remove", "--", path, env=env)
                else:
                    mode = self.entries(tree).get(path, ("100644",))[0]
                    require(mode in {"100644", "100755"}, f"Cannot update nonregular file: {path}")
                    oid = self.command("hash-object", "-w", "--stdin", data=data).decode().strip()
                    self.command("update-index", "--add", "--cacheinfo", f"{mode},{oid},{path}", env=env)
            return self.command("write-tree", env=env).decode().strip()

    def commit(self, tree, parents):
        env = {**os.environ, "GIT_AUTHOR_NAME": "merge preparation", "GIT_AUTHOR_EMAIL": "bot@example.invalid",
               "GIT_COMMITTER_NAME": "merge preparation", "GIT_COMMITTER_EMAIL": "bot@example.invalid"}
        args = ["commit-tree", tree]
        for parent in parents:
            args.extend(["-p", parent])
        return self.command(*args, data=b"Merge preparation virtual input\n", env=env).decode().strip()

    def merge_tree(self, base, head, policy=None):
        # Only the signed-plan path and allowed version fields are reconciled.
        # All other Git conflicts stop; no PR hooks/merge drivers are executed.
        if policy is not None:
            changes = {PLAN: None}
            for spec in policy["version"]["sources"] + policy["version"].get("locks", []):
                b = self.blob(base, spec["path"], spec.get("optional", False))
                h = changes.get(spec["path"], self.blob(head, spec["path"], spec.get("optional", False)))
                if b is not None and h is not None:
                    changes[spec["path"]] = write_field(h, spec, read_field(b, spec))
            for path in [policy["version"].get("revision_path")]:
                if path:
                    changes[path] = self.blob(base, path, True) or b"r0\n"
            base = self.commit(self.patch_tree(base, {PLAN: None}), [base])
            head = self.commit(self.patch_tree(head, changes), [head])
        try:
            result = self.command("merge-tree", "--write-tree", base, head)
        except PreparationError as exc:
            raise PreparationError("Cannot construct the current merge tree; resolve conflicts outside the managed version/plan fields and retry") from exc
        return result.decode().splitlines()[0]

    def projection(self, tree):
        return digest([[path, *entry] for path, entry in sorted(self.entries(tree).items()) if path != PLAN])

    def fetch(self, ref):
        token = os.environ["GH_TOKEN"]
        auth = base64.b64encode(f"x-access-token:{token}".encode()).decode()
        env = {**os.environ, "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "http.extraHeader",
               "GIT_CONFIG_VALUE_0": f"AUTHORIZATION: basic {auth}"}
        # Fetch does not checkout or execute any files from the PR.
        self.command("fetch", "--no-tags", "origin", ref, env=env)


def read_version(git, tree, policy):
    specs = policy["version"]["sources"]
    require(specs, "No version sources declared")
    values = [read_field(git.blob(tree, spec["path"]), spec) for spec in specs]
    require(len(set(values)) == 1, "Declared version sources disagree")
    scheme = policy["version"]["scheme"]
    version_key(values[0], "semver" if scheme == "upstream-revision" else scheme)
    return values[0]


def update_versions(git, tree, policy, version, revision):
    changes = {}
    for spec in policy["version"]["sources"] + policy["version"].get("locks", []):
        blob = changes.get(spec["path"], git.blob(tree, spec["path"], spec.get("optional", False)))
        if blob is not None:
            changes[spec["path"]] = write_field(blob, spec, version)
    if revision is not None:
        changes[policy["version"]["revision_path"]] = (revision + "\n").encode()
    return git.patch_tree(tree, changes)


def key_id(public):
    return hashlib.sha256(public.encode()).hexdigest()


def sign(payload, private):
    with tempfile.TemporaryDirectory() as directory:
        key = Path(directory) / "key.pem"
        key.write_text(private)
        key.chmod(0o600)
        public = run("openssl", "rsa", "-in", str(key), "-pubout").decode()
        signature = run("openssl", "dgst", "-sha256", "-sign", str(key), data=DOMAIN + canonical(payload))
    return {"schema": 1, "key_id": key_id(public), "payload": payload,
            "signature": base64.b64encode(signature).decode()}


def verify(record, keyring):
    require(isinstance(record, dict) and set(record) == {"schema", "key_id", "payload", "signature"}
            and record["schema"] == 1, "Missing or unsupported signed release plan")
    public = keyring.get(record["key_id"])
    require(public, "Unknown release-plan signing key; restore the historical public key")
    with tempfile.TemporaryDirectory() as directory:
        key, signature = Path(directory) / "key.pem", Path(directory) / "signature"
        key.write_text(public)
        try:
            signature.write_bytes(base64.b64decode(record["signature"], validate=True))
        except ValueError as exc:
            raise PreparationError("Invalid release-plan signature encoding") from exc
        run("openssl", "dgst", "-sha256", "-verify", str(key), "-signature", str(signature),
            data=DOMAIN + canonical(record["payload"]))
    return record["payload"]


def restore(git, commit, keyring, repository_id):
    record = json.loads(git.blob(commit, PLAN))
    payload = verify(record, keyring)
    require(payload["repository_id"] == repository_id, "Release plan belongs to another repository")
    require(git.projection(commit) == payload["merge_tree_digest"],
            "Published tree differs from the signed merge tree; regenerate preparation before merging")
    require(read_version(git, commit, payload["policy"]) == payload["generated_version"], "Recorded version disagrees with publication tree")
    if payload.get("generated_revision") is not None:
        require(git.blob(commit, payload["policy"]["version"]["revision_path"]).decode().strip() == payload["generated_revision"],
                "Recorded revision disagrees with publication tree")
    require(publication(payload["policy"], payload["generated_version"], payload.get("generated_revision")) == payload["publication"],
            "Frozen declaration and resolved publication plan disagree")
    return payload


def validate_publisher(payload, environment):
    plan = payload["publication"]
    require(plan["github_release"], "Frozen plan does not authorize a GitHub Release")
    kind = environment.get("RELEASE_PUBLISHER_KIND")
    if kind == "github":
        require(not plan["images"] and plan["release_tag"] == payload["generated_version"],
                "This publisher cannot execute the frozen image/tag contract; use the original compatible workflow")
    expected_repository = environment.get("RELEASE_EXPECTED_IMAGE_REPOSITORY")
    if expected_repository:
        registry = environment["RELEASE_EXPECTED_IMAGE_REGISTRY"]
        require(plan["images"] and all(i["repository"] == expected_repository and i.get("registry", "dockerhub") == registry for i in plan["images"]),
                "Publisher destination differs from frozen plan; rerun the original release workflow rather than infer a destination")
        if registry == "ecr":
            require(all(i["account"] == environment["RELEASE_EXPECTED_ECR_ACCOUNT"] and i["region"] == environment["RELEASE_EXPECTED_ECR_REGION"] for i in plan["images"]),
                    "ECR account/region differs from frozen plan")
    if kind == "docker":
        images = plan["images"]
        require(len(images) == 1 and images[0]["tag"] == plan["release_tag"] == payload["generated_version"]
                and images[0].get("aliases") == ["latest"] and plan["latest_image"] == images[0]["name"],
                "Standard Docker publisher cannot execute this frozen tag/alias contract; select the project pipeline")
    if kind == "project-docker":
        require(all(i.get("aliases", []) == (["latest"] if i["name"] == plan["latest_image"] else []) for i in plan["images"]),
                "Project publisher supports only the declared latest alias; other aliases require an approved publisher change")


def load_policy(git, base):
    policy = json.loads(git.blob(base, POLICY))
    require(policy.get("schema") == 1, "Unsupported merge-preparation declaration")
    require(policy["version"]["scheme"] in {"semver", "chrome", "upstream-revision"}, "Unsupported numbering scheme")
    for spec in policy["version"]["sources"] + policy["version"].get("locks", []):
        require(spec["format"] in {"json", "toml", "text", "toml-lock"}, "Unsupported data-only version format")
        safe_path(spec["path"])
    workflows = policy["ci"]
    require(len({w["path"] for w in workflows}) == len(workflows), "Duplicate CI registration")
    for workflow in workflows:
        require(workflow["event"] == "workflow_dispatch" and workflow["jobs"], "Invalid CI event/job contract")
        require(workflow["path"] not in {".github/workflows/merge-preparation.yml", ".github/workflows/merge-preparation-events.yml"},
                "Merge preparation cannot depend on itself or its event collector")
        safe_path(workflow["path"])
        require(workflow["path"].startswith(".github/workflows/") and "control" not in workflow["jobs"], "Invalid quality workflow/job registration")
    if policy["version"]["scheme"] == "upstream-revision":
        safe_path(policy["version"]["revision_path"])
    return policy


def ci_contract(git, base, policy):
    paths = {SCRIPT}
    for workflow in policy["ci"]:
        paths.add(workflow["path"])
        paths.update(workflow["trusted_paths"])
    for path in policy.get("trusted_paths", []):
        paths.add(path)
    paths.update(p for p in git.entries(base) if p.startswith((".github/scripts/", ".github/actions/", ".github/workflows/", "scripts/")))
    contract = {path: hashlib.sha256(git.blob(base, path)).hexdigest() for path in sorted(paths)}
    declaration = json.loads(git.blob(base, POLICY))
    # CI registration/trust changes need the same prior approval as code.
    # Approval entries themselves remain editable in their separate PR.
    for key in ("ci", "trusted_paths", "trusted_json", "actions_app_id"):
        contract[f"{POLICY}#{key}"] = digest(declaration.get(key))
    for path, keys in policy.get("trusted_json", {}).items():
        data = json.loads(git.blob(base, path))
        for key in keys:
            contract[f"{path}#{key}"] = digest(data[key])
    return contract


def approve_ci_changes(git, base, head, policy):
    contract = ci_contract(git, base, policy)
    candidate = candidate_ci_contract(git, base, head, policy)
    if candidate != contract:
        require(digest(candidate) in policy.get("approved_ci_changes", []),
                "CI definition or trusted script changed without prior base approval; register its exact contract digest in a separate reviewed PR")
    return contract


def candidate_ci_contract(git, base, head, policy):
    contract = ci_contract(git, base, policy)
    candidate = {}
    paths = set(contract) | {p for p in git.entries(head) if p.startswith((".github/workflows/", ".github/actions/", ".github/scripts/", "scripts/"))}
    declaration = json.loads(git.blob(head, POLICY))
    paths.update(safe_path(p) for p in declaration.get("trusted_paths", []))
    for workflow in declaration.get("ci", []):
        paths.add(safe_path(workflow["path"]))
        paths.update(safe_path(p) for p in workflow.get("trusted_paths", []))
    for path, keys in declaration.get("trusted_json", {}).items():
        paths.update(f"{safe_path(path)}#{key}" for key in keys)
    for path in sorted(paths):
        if "#" in path:
            file, key = path.split("#", 1)
            candidate[path] = digest(json.loads(git.blob(head, file)).get(key))
        else:
            blob = git.blob(head, path, optional=True)
            candidate[path] = hashlib.sha256(blob).hexdigest() if blob is not None else None
    return candidate


def check_environment(environment, branch_policies, default_branch, runtime_ref):
    require(runtime_ref == f"refs/heads/{default_branch}", "Privileged run must execute on the default branch")
    require(environment.get("deployment_branch_policy") == {"protected_branches": False, "custom_branch_policies": True},
            "Configure merge-preparation Environment with Selected branches, not Protected branches only")
    rules = branch_policies.get("branch_policies", [])
    require(len(rules) == 1 and rules[0].get("name") == default_branch and rules[0].get("type") == "branch",
            "Environment must allow only the exact default branch; remove PR, wildcard and tag rules")


def accept_run(run_data, jobs, workflow, expected, controller_evidence, checkout_evidence):
    # These API fields are server-owned; evidence comes from the base control job
    # and pre-PR-execution checkout step logs, never a PR-produced artifact.
    require(run_data["id"] == expected["run_id"] and run_data["workflow_id"] == expected["workflow_id"], "Unregistered CI run")
    require(run_data["event"] == workflow["event"] and run_data["path"] == workflow["path"], "Wrong CI event or workflow path")
    require(run_data["actor"]["id"] == expected["actor_id"], "CI was not started by the dedicated App")
    require(run_data["head_sha"] == expected["base"] and run_data["head_branch"] == expected["default_branch"], "Workflow definition SHA/ref mismatch")
    require(run_data["run_attempt"] == expected["attempt"] and run_data["status"] == "completed", "Old or incomplete run attempt")
    require(controller_evidence == {k: expected[k] for k in ("head", "base", "merge", "contract")}, "Base control evidence mismatch")
    by_name = {}
    for job in jobs:
        require(job["name"] not in by_name, f"Ambiguous job: {job['name']}")
        by_name[job["name"]] = job
        require(job.get("run_attempt") == expected["attempt"], "Mixed run attempts")
        require(job.get("runner_name", "").startswith("GitHub Actions"), "Use isolated GitHub-hosted runners")
        require(job.get("app", {}).get("slug") == "github-actions" and job["app"].get("id") == expected["actions_app_id"], "Unexpected check publisher")
    for name in ["control", *workflow["jobs"]]:
        job = by_name.get(name)
        require(job and job["conclusion"] == "success", f"Required CI job did not succeed: {name}")
    for name in workflow["jobs"]:
        require(checkout_evidence.get(name) == expected["merge"], f"Checkout SHA mismatch: {name}")
        steps = by_name[name]["steps"]
        require(any(s["name"] == "Verify candidate checkout before PR execution" and s["conclusion"] == "success" for s in steps),
                f"Missing trusted checkout step: {name}")
    return True


class CredentialRedirect(request.HTTPRedirectHandler):
    """GitHub job logs redirect to storage; never forward the App credential."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        require(parse.urlsplit(newurl).scheme == "https", "Refuse non-HTTPS API redirect")
        redirected = super().redirect_request(req, fp, code, msg, headers, newurl)
        if redirected and parse.urlsplit(req.full_url).netloc != parse.urlsplit(newurl).netloc:
            redirected.remove_header("Authorization")
        return redirected


class GitHub:
    def __init__(self, repository=None):
        self.repository = repository or os.environ["GITHUB_REPOSITORY"]
        self.root = os.environ.get("GITHUB_API_URL", "https://api.github.com")

    def api(self, path, method="GET", payload=None, missing=False, raw=False):
        url = self.root + path
        headers = {"Authorization": f"Bearer {os.environ['GH_TOKEN']}", "Accept": "application/vnd.github+json",
                   "X-GitHub-Api-Version": "2026-03-10", "Content-Type": "application/json"}
        data = canonical(payload) if payload is not None else None
        req = request.Request(url, headers=headers, data=data, method=method)
        try:
            with request.build_opener(CredentialRedirect()).open(req, timeout=30) as response:
                body = response.read()
        except error.HTTPError as exc:
            if missing and exc.code == 404:
                return None
            raise PreparationError(f"GitHub API {method} {path}: HTTP {exc.code}; check installation and permissions") from exc
        except error.URLError as exc:
            raise PreparationError(f"GitHub API unavailable: {exc.reason}") from exc
        return body.decode() if raw else json.loads(body) if body else None

    def repo(self, path="", **kwargs):
        return self.api(f"/repos/{self.repository}{path}", **kwargs)

    def pages(self, path, key=None):
        result = []
        for page in range(1, 1001):
            value = self.repo(f"{path}{'&' if '?' in path else '?'}per_page=100&page={page}")
            rows = value[key] if key else value
            result.extend(rows)
            if len(rows) < 100:
                return result
        raise PreparationError("GitHub pagination exceeded 1000 pages")

    def permission(self, login):
        return self.repo(f"/collaborators/{parse.quote(login, safe='')}/permission")["permission"] in {"write", "maintain", "admin"}

    def check(self, head, state, generation, message, check_id=None, name=CHECK):
        payload = {"name": name, "head_sha": head, "external_id": generation,
                   "status": "completed" if state in {"success", "action_required", "failure"} else "in_progress",
                   "output": {"title": state, "summary": message[:65000]},
                   "details_url": f"https://github.com/{self.repository}/actions/runs/{os.environ.get('GITHUB_RUN_ID', '')}"}
        if payload["status"] == "completed":
            payload["conclusion"] = state
        if check_id:
            payload.pop("head_sha")
            return self.repo(f"/check-runs/{check_id}", method="PATCH", payload=payload)
        return self.repo("/check-runs", method="POST", payload=payload)


def classification(pr, events, permission, input_head, input_diff, editor):
    labels = [item["name"] for item in pr["labels"] if item["name"].startswith("release:")]
    require(len(labels) == 1 and labels[0][8:] in LEVELS, "Set exactly one of release:patch/minor/major")
    matches = re.findall(r"<!--\s*release-classification\s+(\{.*?\})\s*-->", pr.get("body") or "", re.S)
    require(len(matches) == 1, "Add exactly one release-classification JSON marker with head, diff, level and reason")
    evidence = json.loads(matches[0])
    require(evidence.get("head") == input_head and evidence.get("diff") == input_diff,
            "Classification is stale; reassess the substantive diff and update its head/diff")
    require(evidence.get("level") == labels[0][8:] and isinstance(evidence.get("reason"), str) and evidence["reason"].strip(),
            "Classification label and reason disagree")
    label_events = [e for e in events if e.get("event") in {"labeled", "unlabeled"} and e.get("label", {}).get("name") == labels[0]]
    require(label_events and label_events[-1]["event"] == "labeled", "Cannot establish classification label issuer")
    actor = label_events[-1]["actor"]["login"]
    require(permission(actor) and permission(editor), "Classification label/body issuer needs write permission")
    generation = digest({"head": pr["head"]["sha"], "input_head": input_head, "evidence": evidence,
                         "label_event": label_events[-1]["id"], "editor": editor, "updated_at": pr.get("updated_at")})
    return evidence["level"], generation


def classify_dependencies(metadata, changed_paths, policy):
    require(metadata and changed_paths and set(changed_paths) <= set(policy.get("paths", [])), "Dependabot metadata or changed paths need manual classification")
    rules = policy.get("dependencies", {})
    for item in metadata:
        rule = rules.get(item["name"])
        require(rule and rule["ecosystem"] == item["ecosystem"] and rule["usage"] == item["usage"], "Dependabot dependency policy is missing")
        require(item["update"] in {"patch", "minor"} and not item["old_version"].startswith("0."), "Dependabot major/0.x update needs manual classification")
        require(rule.get("compatible_minor_patch") is True, "Dependabot update needs compatibility review")
    return "patch"


def dependency_evidence(gh, git, base, input_head, policy):
    ancestor = git.text("merge-base", base, input_head)
    changed = git.text("diff", "--name-only", ancestor, input_head).splitlines()
    commits = git.text("rev-list", f"{ancestor}..{input_head}").splitlines()
    require(commits, "Dependabot input has no original commits")
    for sha in commits:
        commit = gh.repo(f"/commits/{sha}")
        require(commit.get("author", {}).get("login") == "dependabot[bot]"
                and commit["commit"]["verification"]["verified"] is True,
                "Dependabot input includes an unverified/non-Dependabot commit; classify manually")
    metadata = []
    original, normalized = {}, {}
    # Account for the complete parsed delta, not only known packages in a
    # grouped update. Unsupported lock/hash changes require manual assessment.
    for path in changed:
        sources = [r["source"] for r in policy.get("dependencies", {}).values() if r["source"]["path"] == path]
        require(sources and len({s["format"] for s in sources}) == 1 and sources[0]["format"] in {"json", "toml"},
                f"Dependabot cannot account for every change in {path}; classify manually")
        parser = json.loads if sources[0]["format"] == "json" else tomllib.loads
        original[path] = parser(git.blob(ancestor, path).decode())
        normalized[path] = parser(git.blob(input_head, path).decode())
    for name, rule in policy.get("dependencies", {}).items():
        source = rule["source"]
        if source["path"] not in changed:
            continue
        before = read_field(git.blob(ancestor, source["path"]), source)
        after = read_field(git.blob(input_head, source["path"]), source)
        if before == after:
            continue
        require(isinstance(before, str) and isinstance(after, str), f"Unsupported dependency field: {name}")
        old_match, new_match = re.fullmatch(r"([\^~=]?)(.+)", before), re.fullmatch(r"([\^~=]?)(.+)", after)
        require(old_match and new_match and old_match[1] == new_match[1], f"Dependency range changed: {name}; classify manually")
        get_field(normalized[source["path"]], source["key"][:-1])[source["key"][-1]] = before
        before, after = old_match[2], new_match[2]
        old, new = version_key(before, "semver"), version_key(after, "semver")
        require(new > old, f"Dependency {name} is not a strictly increasing SemVer update")
        level = "major" if new[0][0] != old[0][0] else "minor" if new[0][1] != old[0][1] else "patch"
        metadata.append({"name": name, "ecosystem": rule["ecosystem"], "usage": rule["usage"],
                         "old_version": before, "new_version": after, "update": level})
    require(original == normalized, "Dependabot grouped update includes undeclared fields/packages; classify manually")
    classify_dependencies(metadata, changed, policy)
    return metadata


def remote_collisions(gh, plan):
    collisions = []
    tag = parse.quote(plan["release_tag"], safe="")
    if gh.repo(f"/git/ref/tags/{tag}", missing=True) is not None or gh.repo(f"/releases/tags/{tag}", missing=True) is not None:
        collisions.append("release_tag")
    for image in plan["images"]:
        if image.get("registry", "dockerhub") == "ecr":
            result = subprocess.run(["aws", "ecr", "describe-images", "--registry-id", image["account"],
                "--region", image["region"], "--repository-name", image["repository"], "--image-ids", f"imageTag={image['tag']}"], capture_output=True)
            if result.returncode:
                require(b"ImageNotFoundException" in result.stderr, f"ECR lookup failed for {image['name']}; configure read credentials")
            else:
                collisions.append(image["name"])
        else:
            url = f"https://hub.docker.com/v2/repositories/{image['repository']}/"
            headers = {}
            if os.environ.get("DOCKERHUB_TOKEN"):
                credentials = canonical({"identifier": os.environ["DOCKERHUB_USERNAME"], "secret": os.environ["DOCKERHUB_TOKEN"]})
                with request.urlopen(request.Request("https://hub.docker.com/v2/auth/token", data=credentials,
                    headers={"Content-Type": "application/json"}), timeout=30) as response:
                    headers["Authorization"] = "Bearer " + json.load(response)["access_token"]
            # Repository visibility must be confirmed before interpreting tag 404 as unused.
            try:
                with request.urlopen(request.Request(url, headers=headers), timeout=30):
                    pass
                with request.urlopen(request.Request(url + f"tags/{parse.quote(image['tag'], safe='')}/", headers=headers), timeout=30):
                    collisions.append(image["name"])
            except error.HTTPError as exc:
                require(exc.code == 404 and "/tags/" in exc.url,
                        f"Docker Hub repository/tag lookup failed for {image['name']}: HTTP {exc.code}")
            except error.URLError as exc:
                raise PreparationError(f"Docker Hub lookup failed for {image['name']}: {exc.reason}") from exc
    return collisions


def input_diff(git, base, head, policy):
    ancestor = git.text("merge-base", base, head)
    # Human input includes explicit version fields; only the signed plan is excluded.
    h = git.patch_tree(head, {PLAN: None})
    a = git.patch_tree(ancestor, {PLAN: None})
    entries_a, entries_h = git.entries(a), git.entries(h)
    return digest([[p, entries_a.get(p), entries_h.get(p)] for p in sorted(entries_a.keys() | entries_h.keys())
                   if entries_a.get(p) != entries_h.get(p)])


def prior_plan(git, head, keyring, repository_id):
    # Find the commit that last changed PLAN; a later human commit cannot masquerade as a bot update.
    if PLAN not in git.entries(head):
        return None
    sha = git.text("log", "-1", "--format=%H", head, "--", PLAN)
    payload = restore(git, sha, keyring, repository_id)
    return sha, payload


def save_remote_commit(gh, git, tree, parents, branch, expected_head):
    current = gh.repo(f"/git/ref/heads/{parse.quote(branch, safe='')}")
    require(current["object"]["sha"] == expected_head, "PR head changed during preparation; retry")
    original = git.entries(parents[0])
    target = git.entries(tree)
    updates = []
    for path in sorted(original.keys() | target.keys()):
        if original.get(path) == target.get(path):
            continue
        entry = target.get(path)
        if entry is None:
            updates.append({"path": path, "mode": original[path][0], "type": original[path][1], "sha": None})
        elif entry[1] == "commit":
            updates.append({"path": path, "mode": entry[0], "type": "commit", "sha": entry[2]})
        else:
            blob = gh.repo("/git/blobs", method="POST", payload={"content": base64.b64encode(git.command("cat-file", "blob", entry[2])).decode(), "encoding": "base64"})
            updates.append({"path": path, "mode": entry[0], "type": "blob", "sha": blob["sha"]})
    remote_tree = gh.repo("/git/trees", method="POST", payload={"base_tree": gh.repo(f"/git/commits/{parents[0]}")["tree"]["sha"], "tree": updates})
    require(remote_tree["sha"] == tree, "Remote and local prepared trees disagree")
    commit = gh.repo("/git/commits", method="POST", payload={"message": "chore(release): リリース番号と署名付き公開計画を準備", "tree": tree, "parents": parents})
    # Non-force ref update is optimistic concurrency; no newer head can be overwritten.
    gh.repo(f"/git/refs/heads/{parse.quote(branch, safe='')}", method="PATCH", payload={"sha": commit["sha"], "force": False})
    return commit["sha"]


def api_log_evidence(gh, job, marker):
    text = gh.repo(f"/actions/jobs/{job['id']}/logs", raw=True)
    # GitHub's runner groups step logs. A PR can print arbitrary strings later;
    # only lines inside the fixed pre-execution step are accepted.
    start = "Verify candidate checkout before PR execution" if marker == "CHECKOUT" else "Record trusted CI request"
    groups = text.split("##[group]")
    matching = [g.split("##[endgroup]", 1)[0] for g in groups if start in g.splitlines()[0]]
    require(len(matching) == 1, f"Cannot locate trusted {marker} step log")
    matches = re.findall(r"REPO_TEMPLATE_" + marker + r"=(\{[^\r\n]*\}|[0-9a-f]{40})", matching[0])
    require(len(matches) == 1, f"Missing/ambiguous trusted {marker} evidence")
    return json.loads(matches[0]) if marker == "CONTROL" else matches[0]


def evaluate_ci(gh, policy, expected, contract):
    state = []
    for workflow in policy["ci"]:
        identity = gh.repo(f"/actions/workflows/{parse.quote(workflow['path'].split('/')[-1], safe='')}")
        checks = gh.pages(f"/commits/{expected['head']}/check-runs", "check_runs")
        # Dispatch association is a disposable cache in this App's current check.
        candidates = [c for c in checks if c["name"] == f"CI dispatch / {identity['id']}" and c.get("app", {}).get("id") == expected["app_id"]
                      and c.get("external_id", "").startswith("dispatch:")]
        association = None
        for check in reversed(sorted(candidates, key=lambda c: c["id"])):
            data = json.loads(check["external_id"][9:])
            if data.get("key") == digest({**expected, "contract": digest(contract), "workflow_id": identity["id"]}):
                association = data
                break
        if association is None:
            inputs = {"head": expected["head"], "base": expected["base"], "merge": expected["merge"], "contract": digest(contract)}
            dispatch = gh.repo(f"/actions/workflows/{identity['id']}/dispatches", method="POST",
                               payload={"ref": expected["default_branch"], "inputs": inputs})
            require(dispatch and dispatch.get("workflow_run_id"), "Dispatch API did not return a run ID; use API version 2026-03-10")
            data = {"key": digest({**expected, "contract": digest(contract), "workflow_id": identity["id"]}),
                    "run_id": dispatch["workflow_run_id"]}
            gh.check(expected["head"], "pending", "dispatch:" + canonical(data).decode(),
                     f"CI待ち: {workflow['path']}\n{dispatch['html_url']}", name=f"CI dispatch / {identity['id']}")
            state.append(False)
            continue
        run_data = gh.repo(f"/actions/runs/{association['run_id']}")
        if run_data["status"] != "completed":
            state.append(False)
            continue
        jobs = gh.pages(f"/actions/runs/{run_data['id']}/attempts/{run_data['run_attempt']}/jobs", "jobs")
        for job in jobs:
            check_id = job["check_run_url"].rstrip("/").split("/")[-1]
            job["app"] = gh.repo(f"/check-runs/{check_id}")["app"]
        control = next((j for j in jobs if j["name"] == "control"), None)
        require(control, "CI control job is missing")
        evidence = api_log_evidence(gh, control, "CONTROL")
        checkout = {j["name"]: api_log_evidence(gh, j, "CHECKOUT") for j in jobs if j["name"] in workflow["jobs"]}
        accept_run(run_data, jobs, workflow, {**expected, "run_id": run_data["id"], "workflow_id": identity["id"],
                   "attempt": run_data["run_attempt"], "contract": digest(contract)}, evidence, checkout)
        latest_attempt = gh.repo(f"/actions/runs/{run_data['id']}")
        require(latest_attempt["run_attempt"] == run_data["run_attempt"] and latest_attempt["status"] == "completed",
                "CI attempt changed while reading evidence; reevaluate the latest attempt")
        state.append(True)
        gh.check(expected["head"], "success", "dispatch:" + canonical(association).decode(), f"CI合格: {run_data['html_url']}",
                 association_check_id(association, candidates), name=f"CI dispatch / {identity['id']}")
    return all(state)


def association_check_id(association, candidates):
    return next(c["id"] for c in reversed(sorted(candidates, key=lambda c: c["id"]))
                if json.loads(c["external_id"][9:]) == association)


def preflight_environment(gh, repo):
    environment = gh.repo("/environments/merge-preparation")
    rules = gh.repo("/environments/merge-preparation/deployment-branch-policies")
    check_environment(environment, rules, repo["default_branch"], os.environ["GITHUB_REF"])
    for endpoint in ("/actions/secrets",):
        names = gh.pages(endpoint, "secrets")
        require("MERGE_PREPARATION_APP_PRIVATE_KEY" not in {s["name"] for s in names},
                "Remove the App private key from repository secrets; keep it only in the dedicated Environment")
    if repo["owner"]["type"] == "Organization":
        names = []
        for page in range(1, 1001):
            rows = gh.api(f"/orgs/{repo['owner']['login']}/actions/secrets?per_page=100&page={page}")["secrets"]
            names.extend(rows)
            if len(rows) < 100:
                break
        else:
            raise PreparationError("Organization secret audit exceeded 1000 pages")
        require("MERGE_PREPARATION_APP_PRIVATE_KEY" not in {s["name"] for s in names}, "Remove the App private key from organization secrets")


def preflight_protection(gh, repo, app_id):
    branch = parse.quote(repo["default_branch"], safe="")
    rules = gh.repo(f"/rules/branches/{branch}")
    checks = [r["parameters"] for r in rules if r["type"] == "required_status_checks"]
    classic = gh.repo(f"/branches/{branch}/protection", missing=True)
    if classic and classic.get("required_status_checks"):
        value = classic["required_status_checks"]
        checks.append({"strict_required_status_checks_policy": value["strict"],
                       "required_status_checks": [{"context": c["context"], "integration_id": c["app_id"]} for c in value["checks"]]})
    require(any(c["strict_required_status_checks_policy"] and any(
        s["context"] == CHECK and s["integration_id"] == app_id for s in c["required_status_checks"]) for c in checks),
        "Configure required マージ準備 with the dedicated App as issuer and strict up-to-date; protection changes require separate approval")
    require(any(r["type"] == "pull_request" for r in rules) or classic and classic.get("required_pull_request_reviews"),
            "Keep the existing GitHub pull-request/review protection; setup is incomplete")
    # Native dispatch jobs cannot satisfy these old requirements. Never drop an
    # unknown quality gate automatically; register and migrate it explicitly.
    require(all(s["context"] == CHECK for c in checks for s in c["required_status_checks"]),
            "Migrate every existing required quality check into the base CI registry before replacing native required checks")


def reconcile_pr(gh, git, number, repo, app, private, keyring):
    pr = gh.repo(f"/pulls/{number}")
    if pr["state"] != "open" or pr["base"]["ref"] != repo["default_branch"]:
        return
    head, base = pr["head"]["sha"], gh.repo(f"/commits/{repo['default_branch']}")["sha"]
    require(base == os.environ["GITHUB_SHA"], "Controller definition is behind current base; retry the latest default-branch workflow")
    generation = digest({"head": head, "base": base, "updated_at": pr["updated_at"]})
    check = gh.check(head, "pending", generation, "採番・分類を確認中")
    mirror = None
    try:
        require(pr["head"]["repo"] and pr["head"]["repo"]["id"] == repo["id"],
                "Fork PR: App cannot update this branch; author must prepare versions with the maintainer")
        git.fetch(f"refs/heads/{repo['default_branch']}")
        git.fetch(f"refs/pull/{number}/head")
        policy = load_policy(git, base)
        # Compare the proposed merge with B. An old head may still contain old
        # base scripts that this PR never changed; merging B restores them.
        proposed = git.merge_tree(base, head, policy)
        contract = approve_ci_changes(git, base, proposed, policy)
        prior = prior_plan(git, head, keyring, repo["id"])
        if prior and prior[1].get("pull_request") != number:
            prior = None
        input_head = prior[1]["input_head"] if prior and prior[0] == head else head
        diff = input_diff(git, base, input_head, policy)
        events = gh.pages(f"/issues/{number}/events")
        auto = False
        if pr["user"]["login"] == "dependabot[bot]":
            release_labels = [l["name"] for l in pr["labels"] if l["name"].startswith("release:")]
            label_events = [e for e in events if e.get("event") in {"labeled", "unlabeled"} and e.get("label", {}).get("name", "").startswith("release:")]
            auto = (not release_labels and not label_events) or (label_events and label_events[-1]["actor"]["id"] == app["bot_id"] and label_events[-1]["event"] == "labeled")
            if auto:
                metadata = dependency_evidence(gh, git, base, input_head, policy["dependabot"])
                if not release_labels:
                    marker = {"head": input_head, "diff": diff, "level": "patch", "reason": "Base dependency policy permits all verified minor/patch updates"}
                    body = (pr.get("body") or "") + "\n\n<!-- release-classification " + canonical(marker).decode() + " -->"
                    gh.repo(f"/pulls/{number}", method="PATCH", payload={"body": body})
                    gh.repo(f"/issues/{number}/labels", method="POST", payload={"labels": ["release:patch"]})
                    pr = gh.repo(f"/pulls/{number}")
                    events = gh.pages(f"/issues/{number}/events")
        owner, name = gh.repository.split("/")
        query = 'query($owner:String!,$name:String!,$number:Int!){repository(owner:$owner,name:$name){pullRequest(number:$number){editor{login} author{login}}}}'
        body_meta = gh.api("/graphql", method="POST", payload={"query": query, "variables": {"owner": owner, "name": name, "number": number}})
        require(not body_meta.get("errors"), "Cannot verify classification body editor")
        meta = body_meta["data"]["repository"]["pullRequest"]
        editor = (meta["editor"] or meta["author"])["login"]
        bot_login = next((e["actor"]["login"] for e in events if e.get("actor", {}).get("id") == app["bot_id"]), None)
        permitted = lambda login: bool(auto and login == bot_login) or gh.permission(login)
        level, generation = classification(pr, events, permitted, input_head, diff, editor)
        initial_label_events = [e["id"] for e in events if e.get("event") in {"labeled", "unlabeled"} and e.get("label", {}).get("name", "").startswith("release:")]
        if prior and prior[0] == head:
            explicit = prior[1]["explicit_minimum"]
            explicit_revision = prior[1].get("explicit_revision")
            input_version = prior[1]["input_version"]
        else:
            input_version = read_version(git, input_head, policy)
            ancestor_version = read_version(git, git.text("merge-base", base, input_head), policy)
            if prior and input_version == prior[1]["generated_version"]:
                explicit = prior[1]["explicit_minimum"]
                input_version = prior[1]["input_version"]
            else:
                explicit = input_version if input_version != ancestor_version else None
            explicit_revision = None
        base_version = read_version(git, base, policy)
        revision_path = policy["version"].get("revision_path")
        base_revision = (git.blob(base, revision_path, True) or b"r0").decode().strip() if revision_path else None
        if revision_path and (not prior or prior[0] != head):
            current_revision = (git.blob(input_head, revision_path, True) or b"r0").decode().strip()
            old_revision = (git.blob(git.text("merge-base", base, input_head), revision_path, True) or b"r0").decode().strip()
            if prior and current_revision == prior[1].get("generated_revision"):
                explicit_revision = prior[1].get("explicit_revision")
            elif current_revision != old_revision:
                explicit_revision = current_revision
        previous = (prior[1]["generated_version"], prior[1].get("generated_revision")) if prior else None
        version, revision, resolved = choose(policy, base_version, level, explicit, lambda p: remote_collisions(gh, p),
            base_revision=base_revision, input_version=input_version, explicit_revision=explicit_revision, previous=previous)
        reusable = prior and prior[0] == head and prior[1]["generated_base_sha"] == base and prior[1]["policy"] == policy \
            and prior[1]["level"] == level and prior[1]["generated_version"] == version and prior[1].get("generated_revision") == revision
        if not reusable:
            merged = git.merge_tree(base, head, policy)
            prepared = update_versions(git, merged, policy, version, revision)
            payload = {"repository_id": repo["id"], "pull_request": number, "input_head": input_head, "input_diff": diff,
                       "input_version": input_version, "generated_base_sha": base, "executor_sha": base,
                       "explicit_minimum": explicit, "explicit_revision": explicit_revision, "level": level,
                       "generated_version": version, "generated_revision": revision, "policy": policy,
                       "ci_contract": contract, "publication": resolved, "merge_tree_digest": git.projection(prepared)}
            record = sign(payload, private)
            tree = git.patch_tree(prepared, {PLAN: canonical(record) + b"\n"})
            parents = [head] if git.text("merge-base", base, head) == base else [head, base]
            head = save_remote_commit(gh, git, tree, parents, pr["head"]["ref"], head)
            gh.check(pr["head"]["sha"], "action_required", generation, f"bot更新後のheadで再評価します: {head}", check["id"])
            check = gh.check(head, "pending", generation, "version・署名付き計画を更新。CI待ち")
        latest = gh.repo(f"/pulls/{number}")
        require(latest["head"]["sha"] == head and latest["base"]["sha"] == base, "Head/base changed; retry preparation")
        require(latest["body"] == pr["body"] and latest["labels"] == pr["labels"], "Classification changed during bot update; reevaluate")
        _, generation = classification(latest, events, permitted, input_head, diff, editor)
        decision_updated_at = latest["updated_at"]
        git.fetch(f"refs/pull/{number}/merge")
        merge = git.text("rev-parse", "FETCH_HEAD")
        parents = git.text("show", "-s", "--format=%P", merge).split()
        require(parents == [base, head], "Test merge is stale or conflicting; wait for GitHub to regenerate it")
        signed = restore(git, head, keyring, repo["id"])
        require(git.projection(merge) == signed["merge_tree_digest"], "Test merge tree differs from signed publication tree")
        mirror = gh.check(merge, "pending", generation, "最新test-mergeのCI待ち")
        expected = {"head": head, "base": base, "merge": merge, "default_branch": repo["default_branch"],
                    "actor_id": app["bot_id"], "app_id": app["id"], "actions_app_id": policy["actions_app_id"]}
        complete = evaluate_ci(gh, policy, expected, contract)
        # Always reread live classification and base after waiting; delayed events never publish cached success.
        final = gh.repo(f"/pulls/{number}")
        require(final["head"]["sha"] == head and final["base"]["sha"] == base
                and final["body"] == pr["body"] and final["labels"] == pr["labels"]
                and final["updated_at"] == decision_updated_at, "Inputs changed during preparation; retry")
        final_events = gh.pages(f"/issues/{number}/events")
        require(initial_label_events == [e["id"] for e in final_events if e.get("event") in {"labeled", "unlabeled"} and e.get("label", {}).get("name", "").startswith("release:")],
                "Classification generation changed on the same head; discard this result and reevaluate")
        require(final["merge_commit_sha"] == merge, "Current test-merge changed; discard old CI")
        final_meta = gh.api("/graphql", method="POST", payload={"query": query, "variables": {"owner": owner, "name": name, "number": number}})
        require(not final_meta.get("errors"), "Cannot verify current classification body editor")
        current_meta = final_meta["data"]["repository"]["pullRequest"]
        current_editor = (current_meta["editor"] or current_meta["author"])["login"]
        require(current_editor == editor and permitted(current_editor), "Classification body editor changed; reevaluate")
        state = "success" if complete else "pending"
        text = "準備完了（採番・対象CI合格）。レビュー要件はGitHubが判定します。" if complete else "CI待ち。対象run完了時に再評価します。"
        for sha, item in [(head, check), (merge, mirror)]:
            gh.check(sha, state, generation, text + f"\nH0={input_head}\nH1={head}\nB={base}\nM={merge}", item["id"])
    except (PreparationError, KeyError, ValueError, OSError) as exc:
        message = f"要対応: {exc}"
        gh.check(head, "action_required", generation, message, check["id"])
        if mirror:
            gh.check(mirror["head_sha"], "action_required", generation, message, mirror["id"])
        print(message)


def ci_control(git, gh, args):
    repo = gh.repo()
    require(os.environ["GITHUB_EVENT_NAME"] == "workflow_dispatch", "CI must be dispatched by the App")
    require(os.environ["GITHUB_REF"] == f"refs/heads/{repo['default_branch']}" and os.environ["GITHUB_SHA"] == args.base,
            "CI definition ref/SHA changed; retry from the latest base")
    require(os.environ["GITHUB_WORKFLOW_SHA"] == args.base, "Workflow definition is not pinned to B")
    require(os.environ["GITHUB_ACTOR_ID"] == os.environ["MERGE_PREPARATION_APP_BOT_ID"], "Wrong CI dispatch actor")
    for value in (args.head, args.base, args.merge):
        require(SHA.fullmatch(value), "Invalid request SHA")
    policy = load_policy(git, args.base)
    require(digest(ci_contract(git, args.base, policy)) == args.contract, "CI contract changed")
    git.fetch(args.merge)
    require(git.text("show", "-s", "--format=%P", args.merge).split() == [args.base, args.head], "Invalid test-merge parents")
    contract = approve_ci_changes(git, args.base, args.merge, policy)
    load_policy(git, args.merge)  # Validate candidate declaration as data only.
    if candidate_ci_contract(git, args.base, args.merge, policy) != contract:
        # Static tools inspect candidate definitions; no candidate control code
        # or local Action is ever executed in this control job.
        with tempfile.TemporaryDirectory() as directory:
            paths = []
            for path in git.entries(args.merge):
                if path.startswith((".github/workflows/", ".github/actions/")):
                    target = Path(directory) / path
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(git.blob(args.merge, path))
                    if path.startswith(".github/workflows/") and path.endswith((".yml", ".yaml")):
                        paths.append(path)
            tool = ["actionlint"] if shutil.which("actionlint") else ["go", "run", "github.com/rhysd/actionlint/cmd/actionlint@v1.7.12"]
            run(*tool, "-shellcheck=", "-pyflakes=", "-ignore", '^unexpected key "queue" for "concurrency" section', *paths,
                cwd=directory, env={**os.environ, "GOWORK": "off"})
    proof = {"head": args.head, "base": args.base, "merge": args.merge, "contract": args.contract}
    print("::group::Record trusted CI request")
    print("REPO_TEMPLATE_CONTROL=" + canonical(proof).decode())
    print("::endgroup::")
    for key, value in proof.items():
        output(key, value)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["reconcile", "ci-control", "checkout-proof", "restore", "diff", "environment-check", "configuration-check", "npm-script", "candidate-command", "read-version", "ci-changes"])
    parser.add_argument("--root", default=".")
    for name in ("head", "base", "merge", "contract"):
        parser.add_argument("--" + name)
    parser.add_argument("--candidate")
    parser.add_argument("--name")
    parser.add_argument("--command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    git = Git(args.root)
    if args.action == "candidate-command":
        require(args.command, "Missing isolated candidate command")
        raise SystemExit(candidate_command(args.root, args.candidate, args.command))
    if args.action == "configuration-check":
        for name in ("MERGE_PREPARATION_APP_PRIVATE_KEY", "MERGE_PREPARATION_PUBLIC_KEYS", "MERGE_PREPARATION_APP_CLIENT_ID", "MERGE_PREPARATION_APP_ID", "MERGE_PREPARATION_APP_BOT_ID"):
            require(os.environ.get(name), f"Missing {name}; follow docs/merge-preparation.md and separately approve App/Environment setup")
        for name in ("MERGE_PREPARATION_APP_ID", "MERGE_PREPARATION_APP_BOT_ID"):
            require(os.environ[name].isdigit(), f"Invalid {name}; register the numeric App/bot ID")
        keyring = json.loads(os.environ["MERGE_PREPARATION_PUBLIC_KEYS"])
        with tempfile.TemporaryDirectory() as directory:
            key = Path(directory) / "key.pem"
            key.write_text(os.environ["MERGE_PREPARATION_APP_PRIVATE_KEY"])
            key.chmod(0o600)
            public = run("openssl", "rsa", "-in", str(key), "-pubout").decode()
        require(keyring.get(key_id(public)) == public, "Register this App's public key in the Environment keyring before preparing any commit")
        return
    if args.action == "read-version":
        policy = json.loads((Path(args.root) / POLICY).read_text())
        values = [read_field((Path(args.root) / safe_path(s["path"])).read_bytes(), s) for s in policy["version"]["sources"]]
        require(len(set(values)) == 1, "Declared version sources disagree")
        version_key(values[0], "semver" if policy["version"]["scheme"] == "upstream-revision" else policy["version"]["scheme"])
        output("version", values[0])
        return
    if args.action == "npm-script":
        root = Path(args.root).resolve()
        scripts = json.loads((root / "package.json").read_text())["scripts"]
        require(args.name in scripts, f"Missing approved npm script: {args.name}")
        def expand(name, seen):
            require(name not in seen, f"Recursive npm script: {name}")
            command = scripts[name]
            command = re.sub(r"npm run ([a-zA-Z0-9:_-]+)", lambda m: "(" + expand(m[1], seen | {name}) + ")", command)
            command = re.sub(r"node (scripts/[a-zA-Z0-9_./-]+)", lambda m: "node " + str(root / safe_path(m[1])), command)
            return command
        command = 'export PATH="$PWD/node_modules/.bin:$PATH"; ' + expand(args.name, set())
        raise SystemExit(candidate_command(root, args.candidate, ["bash", "-euc", command]))
    if args.action == "checkout-proof":
        require(SHA.fullmatch(args.merge or ""), "Invalid expected checkout SHA")
        require(git.text("rev-parse", "HEAD") == args.merge, "Candidate checkout did not match M")
        print("::group::Verify candidate checkout before PR execution")
        print("REPO_TEMPLATE_CHECKOUT=" + args.merge)
        print("::endgroup::")
        return
    if args.action == "diff":
        policy = load_policy(git, args.base)
        print(input_diff(git, args.base, args.head, policy))
        return
    if args.action == "ci-changes":
        policy = load_policy(git, args.base)
        candidate = candidate_ci_contract(git, args.base, git.merge_tree(args.base, args.head, policy), policy)
        print(json.dumps({"candidate_digest": digest(candidate), "candidate": candidate}, indent=2))
        return
    gh = GitHub()
    if args.action == "ci-control":
        ci_control(git, gh, args)
        return
    keyring = json.loads(os.environ.get("MERGE_PREPARATION_PUBLIC_KEYS", "{}"))
    repo = gh.repo()
    if args.action == "environment-check":
        check_environment(gh.repo("/environments/merge-preparation"), gh.repo("/environments/merge-preparation/deployment-branch-policies"),
                          repo["default_branch"], os.environ["GITHUB_REF"])
        require(git.text("rev-parse", "HEAD") == os.environ["GITHUB_WORKFLOW_SHA"], "Privileged code must match the executing workflow SHA")
        return
    if args.action == "restore":
        payload = restore(git, git.text("rev-parse", "HEAD"), keyring, repo["id"])
        validate_publisher(payload, os.environ)
        Path(os.environ.get("RELEASE_PLAN_OUTPUT", "/tmp/repo-template-release-plan.json")).write_bytes(canonical(payload))
        output("version", payload["publication"]["release_tag"])
        output("project-version", payload["generated_version"])
        if os.environ.get("GITHUB_ENV"):
            with open(os.environ["GITHUB_ENV"], "a") as stream:
                stream.write(f"PREPARED_RELEASE_TAG={payload['publication']['release_tag']}\n")
                stream.write(f"PREPARED_PROJECT_VERSION={payload['generated_version']}\n")
        return
    preflight_environment(gh, repo)
    require(keyring, "Register the historical public-key keyring in merge-preparation Environment")
    private = os.environ.get("MERGE_PREPARATION_APP_PRIVATE_KEY", "")
    require(private, "Register the dedicated App private key in merge-preparation Environment only")
    app = {"id": int(os.environ["MERGE_PREPARATION_APP_ID"]), "bot_id": int(os.environ["MERGE_PREPARATION_APP_BOT_ID"])}
    require(gh.repo(f"/commits/{repo['default_branch']}")["sha"] == os.environ["GITHUB_WORKFLOW_SHA"] == git.text("rev-parse", "HEAD"),
            "Privileged workflow/code is not the current trusted base; rerun from default branch")
    preflight_protection(gh, repo, app["id"])
    for pr in gh.pages(f"/pulls?state=open&base={parse.quote(repo['default_branch'], safe='')}"):
        reconcile_pr(gh, git, pr["number"], repo, app, private, keyring)


if __name__ == "__main__":
    try:
        main()
    except (PreparationError, KeyError, ValueError, OSError) as exc:
        print(f"::error::要対応: {exc}", file=sys.stderr)
        raise SystemExit(1)
