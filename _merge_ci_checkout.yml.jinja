      # Both checkouts use explicit SHAs. M never overwrites the B control tree.
      - name: Checkout trusted control code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ inputs.base }}' }}
          path: trusted-control
          persist-credentials: false
      - name: Checkout candidate
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ needs.control.outputs.merge }}' }}
          path: candidate
          persist-credentials: false
      - name: Verify candidate checkout before PR execution
        working-directory: {{ '${{ github.workspace }}' }}
        env:
          EXPECTED_MERGE: {{ '${{ needs.control.outputs.merge }}' }}
        run: python3 -I trusted-control/.github/scripts/merge-preparation.py checkout-proof --root candidate --merge "$EXPECTED_MERGE"
      - name: Install candidate execution isolation
        working-directory: {{ '${{ github.workspace }}' }}
        run: |
          sudo apt-get update
          sudo apt-get install -y bubblewrap
          if [[ -r /proc/sys/kernel/apparmor_restrict_unprivileged_userns && $(</proc/sys/kernel/apparmor_restrict_unprivileged_userns) == 1 ]]; then
            printf '%s\n' 'abi <abi/4.0>,' 'include <tunables/global>' '/usr/bin/bwrap flags=(unconfined) {' '  userns,' '}' | sudo tee /etc/apparmor.d/merge-preparation-bwrap > /dev/null
            sudo apparmor_parser -r /etc/apparmor.d/merge-preparation-bwrap
          fi
