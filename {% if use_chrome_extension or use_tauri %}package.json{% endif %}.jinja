{% import '_language_toolchain.jinja' as tools -%}
{
{%- if use_tauri %}
  "name": {{ tauri_package_name | tojson }},
  "version": {{ tauri_version | tojson }},
  "description": {{ tauri_product_name | tojson }},
{%- else %}
  "name": {{ project_name | tojson }},
  "version": {{ chrome_extension_version | tojson }},
  "description": {{ chrome_extension_description | tojson }},
{%- endif %}
  "private": true,
  "type": "module",
  "author": {{ author_name | tojson }},
  "license": {{ ("MIT" if use_mit_license else "UNLICENSED") | tojson }},
  "scripts": {
{%- if use_tauri %}
    "build": "tsc -p tsconfig.build.json && vite build",
    "cargo:clippy": "{{ tools.cargo_quality('clippy', 'src-tauri/Cargo.toml') }}",
    "cargo:fmt": "{{ tools.cargo_quality('fmt', 'src-tauri/Cargo.toml') }}",
    "cargo:test": "{{ tools.cargo_quality('test', 'src-tauri/Cargo.toml') }}",
    "check": "{{ tools.npm_check(["cargo:fmt", "cargo:clippy", "cargo:test"]) }}",
    "dev": "vite",
{%- else %}
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-extension-assets.mjs",
    "check": "{{ tools.npm_check() }}",
    "clean": "node scripts/clean-dist.mjs",
{%- endif %}
    "format": {{ tools.npm_scripts["format"] | tojson }},
    "format:check": {{ tools.npm_scripts["format:check"] | tojson }},
    "lint": {{ tools.npm_scripts["lint"] | tojson }},
{%- if use_tauri %}
    "preview": "vite preview",
    "tauri": "tauri",
{%- endif %}
    "test": {{ tools.npm_scripts["test"] | tojson }},
    "test:run": {{ tools.npm_scripts["test:run"] | tojson }},
    "typecheck": {{ tools.npm_scripts["typecheck"] | tojson }}
  },
{%- if use_tauri %}
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
{%- endif %}
  "devDependencies": {
{%- if use_tauri %}
    "@tauri-apps/cli": "^2.11.4",
{%- endif %}
{%- if use_chrome_extension %}
    "@types/chrome": "^0.2.5",
{%- endif %}
    "@types/node": {{ tools.npm_dev_tools["@types/node"] | tojson }},
    "oxlint": {{ tools.npm_dev_tools["oxlint"] | tojson }},
    "oxlint-tsgolint": {{ tools.npm_dev_tools["oxlint-tsgolint"] | tojson }},
    "prettier": {{ tools.npm_dev_tools["prettier"] | tojson }},
    "typescript": {{ tools.npm_dev_tools["typescript"] | tojson }},
{%- if use_tauri %}
    "vite": "^8.2.1",
{%- endif %}
    "vitest": {{ tools.npm_dev_tools["vitest"] | tojson }}
  }
}
