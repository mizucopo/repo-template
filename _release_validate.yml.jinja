{% if use_python %}
      - name: Set up Python
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version-file: .python-version
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
      - name: Validate Python release
        run: |
          uv sync --locked
          uv run task check
{% if python_project_kind != 'application' %}          uv build
{% endif %}{% endif %}{% if use_chrome_extension or use_tauri %}
      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version-file: .node-version
{% if use_tauri %}
      - name: Install Tauri Rust toolchain
        run: rustup show
      - name: Install Tauri Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libayatana-appindicator3-dev \
            librsvg2-dev \
            libwebkit2gtk-4.1-dev \
            libgtk-3-dev \
            libxdo-dev
{% endif %}
      - name: Validate Node release
        run: |
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
          npm run check
{% endif %}{% if use_rust %}
      - name: Install Rust toolchain
        run: rustup show
      - name: Validate Rust release
        run: |
          cargo fmt --all --check
          cargo clippy --all-targets --all-features -- -D warnings
          cargo test --all-targets --all-features
          cargo build --release --locked
{% endif %}
