{% from "_action_pins.yml.jinja" import action %}{% if use_python %}
      - name: Set up Python
        uses: {{ action('actions/setup-python') }}
        with:
          python-version-file: .python-version
      - uses: {{ action('astral-sh/setup-uv') }}
      - name: Validate Python release
        run: |
          uv sync --locked
          uv run task check
{% if python_project_kind != 'application' %}          uv build
{% endif %}{% endif %}{% if use_chrome_extension or use_tauri %}
      - name: Set up Node.js
        uses: {{ action('actions/setup-node') }}
        with:
          node-version-file: .node-version
{% if use_tauri %}
      - name: Install Tauri Rust toolchain
        run: rustup show
      - name: Install Tauri Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libayatana-appindicator3-dev \
            librsvg2-dev \
            libwebkit2gtk-4.1-dev \
            libgtk-3-dev \
            libxdo-dev
{% endif %}
      - name: Validate Node release
        run: |
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
          npm run check
{% endif %}{% if use_rust %}
      - name: Install Rust toolchain
        run: rustup show
      - name: Validate Rust release
        run: |
          cargo fmt --all --check
          cargo clippy --all-targets --all-features -- -D warnings
          cargo test --all-targets --all-features
          cargo build --release --locked
{% endif %}
