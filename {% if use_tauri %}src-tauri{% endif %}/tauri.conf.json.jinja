{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": {{ tauri_product_name | tojson }},
  "version": {{ tauri_version | tojson }},
  "identifier": {{ tauri_identifier | tojson }},
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": {{ tauri_product_name | tojson }},
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": "all"
  }
}
