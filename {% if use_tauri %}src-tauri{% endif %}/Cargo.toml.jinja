[package]
name = "test-tauri-app"
version = {{ tauri_version | tojson }}
description = {{ tauri_product_name | tojson }}
authors = [{{ author_name | tojson }}]
edition = "2024"

[lib]
name = "test_tauri_app_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2.6.3", features = [] }

[dependencies]
tauri = { version = "2.11.3", features = [] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
