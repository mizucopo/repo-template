{% import '_language_toolchain.jinja' as tools -%}
[package]
name = {{ project_name | tojson }}
version = {{ project_version | tojson }}
edition = {{ tools.rust_edition | tojson }}
description = {{ project_description | tojson }}
authors = [{{ author_name | tojson }}]

{% if rust_cli_release_profile == "thin-lto-strip" -%}
[profile.release]
lto = {{ tools.rust_cli_release_lto | tojson }}
strip = {{ tools.rust_cli_release_strip | tojson }}

{% endif -%}
[dependencies]
