import { formatExtensionTitle } from "./lib/extension-title.js";

const titleElement = document.querySelector<HTMLHeadingElement>("[data-extension-title]");

if (!titleElement) {
  throw new Error("Popup title element was not found.");
}

// prettier-ignore
titleElement.textContent = formatExtensionTitle(
  {{ chrome_extension_name | tojson }},
  {{ chrome_extension_version | tojson }},
);
