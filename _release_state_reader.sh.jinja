set -euo pipefail

git fetch --force --tags

HEAD_SHA="$(git rev-parse HEAD)"
tag_exists=false
release_exists=false
release_asset_exists=false
release_is_draft=false
release_id=

if git show-ref --tags --verify --quiet "refs/tags/$TAG"; then
  TAG_SHA="$(git rev-list -n 1 "refs/tags/$TAG")"
  if [ "$TAG_SHA" != "$HEAD_SHA" ]; then
    echo "::error::Tag $TAG already points to $TAG_SHA, not $HEAD_SHA."
    exit 1
  fi
  tag_exists=true
fi

RELEASE_RESPONSE="$(mktemp)"
trap 'rm -f "$RELEASE_RESPONSE"' EXIT

set +e
RELEASE_HTTP_STATUS="$(
  curl --silent --show-error --location \
    --output "$RELEASE_RESPONSE" \
    --write-out '%{http_code}' \
    --header "Accept: application/vnd.github+json" \
    --header "Authorization: Bearer $GH_TOKEN" \
    --header "X-GitHub-Api-Version: 2022-11-28" \
    "$GITHUB_API_URL/repos/$GITHUB_REPOSITORY/releases/tags/$TAG"
)"
CURL_STATUS=$?
set -e

if [ "$CURL_STATUS" -ne 0 ]; then
  echo "::error::Could not inspect GitHub Release $TAG."
  exit "$CURL_STATUS"
fi

case "$RELEASE_HTTP_STATUS" in
  200)
    release_exists=true
    ;;
  404)
    ;;
  *)
    echo "::error::Could not inspect GitHub Release $TAG: HTTP $RELEASE_HTTP_STATUS."
    exit 1
    ;;
esac

if [ "${INSPECT_DRAFT_RELEASES:-false}" = "true" ]; then
  # The tag endpoint returns published releases only. Always include every page
  # of the authenticated listing to detect drafts and duplicate matching tags.
  if ! gh api --paginate --slurp \
    "/repos/$GITHUB_REPOSITORY/releases?per_page=100" \
    | jq --arg tag "$TAG" \
      '[.[][] | select(.tag_name == $tag)] |
       if length == 0 then null
       elif length == 1 then .[0]
       else error("Multiple GitHub Releases match the tag") end' \
      > "$RELEASE_RESPONSE"; then
    echo "::error::Could not inspect draft GitHub Releases for $TAG."
    exit 1
  fi
  if [ -n "${RELEASE_ID:-}" ]; then
    if ! [[ "$RELEASE_ID" =~ ^[1-9][0-9]*$ ]] \
      || ! jq -e --argjson id "$RELEASE_ID" \
        '. == null or .id == $id' "$RELEASE_RESPONSE" > /dev/null; then
      echo "::error::Listed GitHub Release differs from retained ID."
      exit 1
    fi
    gh api "/repos/$GITHUB_REPOSITORY/releases/$RELEASE_ID" > "$RELEASE_RESPONSE"
    if ! jq -e --argjson id "$RELEASE_ID" '.id == $id' "$RELEASE_RESPONSE" > /dev/null; then
      echo "::error::GitHub Release ID differs from retained ID."
      exit 1
    fi
  fi
  if [ "$(jq -r '. != null' "$RELEASE_RESPONSE")" = "true" ]; then
    release_exists=true
  fi

  if [ "$release_exists" = "true" ]; then
    if ! release_id="$(jq -er '.id | select(type == "number" and . > 0 and floor == .)' "$RELEASE_RESPONSE")" \
      || ! release_is_draft="$(jq -er '.draft | select(type == "boolean") | tostring' "$RELEASE_RESPONSE")" \
      || ! jq -e --arg tag "$TAG" '.tag_name == $tag and (.assets | type == "array")' "$RELEASE_RESPONSE" > /dev/null; then
      echo "::error::GitHub Release $TAG returned invalid release metadata."
      exit 1
    fi
  fi
fi

if [ "$release_exists" = "true" ] && [ "$tag_exists" != "true" ]; then
  echo "::error::GitHub Release $TAG exists, but the matching git tag was not found."
  exit 1
fi

if [ -n "${RELEASE_ASSET_NAME:-}" ] && [ -n "${RELEASE_ASSET_NAMES:-}" ]; then
  echo "::error::Specify only one release asset input."
  exit 1
fi

if [ "$release_exists" = "true" ] && [ -n "${RELEASE_ASSET_NAME:-}${RELEASE_ASSET_NAMES:-}" ]; then
  if [ -n "${RELEASE_ASSET_NAMES:-}" ]; then
    IFS='|' read -r -a expected_assets <<< "$RELEASE_ASSET_NAMES"
  else
    expected_assets=("$RELEASE_ASSET_NAME")
  fi
  release_asset_exists=true
  for asset_name in "${expected_assets[@]}"; do
    if [ -z "$asset_name" ]; then
      echo "::error::Release asset name must not be empty."
      exit 1
    fi
    if ! asset_exists="$(
      jq -r --arg name "$asset_name" \
        --argjson require_uploaded "${INSPECT_DRAFT_RELEASES:-false}" \
        'any(.assets[]?; .name == $name and
          ($require_uploaded == false or
           (.state == "uploaded" and (.size | type == "number" and . > 0))))' \
        "$RELEASE_RESPONSE"
    )"; then
      echo "::error::Could not inspect assets for GitHub Release $TAG."
      exit 1
    fi
    case "$asset_exists" in
      true) ;;
      false) release_asset_exists=false ;;
      *)
        echo "::error::GitHub Release $TAG returned an invalid asset state."
        exit 1
        ;;
    esac
  done
fi

{
  echo "tag_exists=$tag_exists"
  echo "release_exists=$release_exists"
  echo "release_asset_exists=$release_asset_exists"
  if [ "${INSPECT_DRAFT_RELEASES:-false}" = "true" ]; then
    echo "release_is_draft=$release_is_draft"
    echo "release_id=$release_id"
  fi
} >> "$GITHUB_OUTPUT"
