{
  "name": "test-extension",
  "version": {{ chrome_extension_version | tojson }},
  "description": {{ chrome_extension_description | tojson }},
  "private": true,
  "type": "module",
  "author": "{{ author_name }}",
  "license": {{ ("MIT" if use_mit_license else "UNLICENSED") | tojson }},
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-extension-assets.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:run && npm run build",
    "clean": "node scripts/clean-dist.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.0",
    "@types/node": "^24.13.2",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
