  cleanup-image-owners:
    needs: [prepare, release, promote-latest]
    if: always() && !cancelled() && needs.prepare.outputs.publish == 'true' && needs.release.result == 'success' && (needs.promote-latest.result == 'success' || needs.promote-latest.result == 'skipped')
    runs-on: ubuntu-latest
    env:
      RELEASE_SHA: {{ '${{ needs.prepare.outputs.release_sha }}' }}
{% if not use_aws_ecr %}      DOCKERHUB_USERNAME: {{ (docker_project_login_username if use_gh_actions_docker_project_pipeline else docker_login_username) | tojson }}
      DOCKERHUB_TOKEN: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{% endif %}    steps:
      - name: Checkout numbering commit
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: {{ '${{ needs.prepare.outputs.release_sha }}' }}
          fetch-depth: 0

{% include '_release_checkout.yml.jinja' %}{% if use_aws_ecr %}
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@e6de054238d6b7531b4efff3b6587d9aade6a06c # v6.2.3
        with:
          role-to-assume: {{ '${{ secrets.AWS_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}
{% endif %}
{% if use_rust and not use_gh_actions_docker_project_pipeline %}      - name: Download verified Rust distributions
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          pattern: rust-release-*
          path: {{ '${{ runner.temp }}/rust-release' }}
{% endif %}      - name: Retain image digests and remove completed ownership markers
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
{% if use_rust and not use_gh_actions_docker_project_pipeline %}          RUST_RELEASE_DIR: {{ '${{ runner.temp }}/rust-release' }}
{% endif %}        run: python3 -I .github/scripts/release.py image-owner-complete
