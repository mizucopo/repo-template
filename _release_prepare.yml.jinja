  prepare:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: read
{% if use_aws_ecr %}      id-token: write
{% endif %}    outputs:
      publish: {{ "${{ steps.prepare.outputs.publish || 'false' }}" }}
      release_sha: {{ '${{ steps.prepare.outputs.release_sha }}' }}
      release_tag: {{ '${{ steps.prepare.outputs.release_tag }}' }}
      version: {{ '${{ steps.prepare.outputs.version }}' }}
    steps:
      - name: Validate release branch
        run: |
          if [ "$GITHUB_REF" != 'refs/heads/main' ]; then
            echo '::error::Release requires main. Select the main branch when running this workflow manually.'
            exit 1
          fi
      - name: Checkout control code
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
{% if use_aws_ecr %}
      - name: Inspect release intent before authenticating
        id: intent
        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
        run: python3 -I .github/scripts/release.py intent
      - name: Configure ECR lookup credentials
        if: {{ "${{ steps.intent.outputs.publish == 'true' }}" }}
        uses: aws-actions/configure-aws-credentials@e6de054238d6b7531b4efff3b6587d9aade6a06c # v6.2.3
        with:
          role-to-assume: {{ '${{ secrets.AWS_ROLE_ARN }}' }}
          aws-region: {{ aws_region }}
{% endif %}
      - name: Number latest main and reserve its tag
        id: prepare
{% if use_aws_ecr %}        if: {{ "${{ steps.intent.outputs.publish == 'true' }}" }}
{% endif %}        env:
          GH_TOKEN: {{ '${{ github.token }}' }}
          GIT_AUTHOR_NAME: {{ author_name | tojson }}
          GIT_AUTHOR_EMAIL: {{ author_email | tojson }}
          GIT_COMMITTER_NAME: {{ author_name | tojson }}
          GIT_COMMITTER_EMAIL: {{ author_email | tojson }}
{% if (use_gh_actions_docker_release or use_gh_actions_docker_project_pipeline) and not use_aws_ecr %}
          DOCKERHUB_USERNAME: {{ (docker_project_login_username if use_gh_actions_docker_project_pipeline else docker_login_username) | tojson }}
          DOCKERHUB_TOKEN: {{ '${{ secrets.DOCKERHUB_TOKEN }}' }}
{% endif %}        run: python3 -I .github/scripts/release.py prepare
