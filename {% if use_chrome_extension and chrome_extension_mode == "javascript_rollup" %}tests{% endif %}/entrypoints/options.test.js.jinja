import { beforeEach, describe, expect, it, vi } from "vitest";

describe("options entrypoint", () => {
  beforeEach(() => {
    vi.resetModules();
    document.body.innerHTML = "<main><p data-options-status></p></main>";
  });

  it("updates the options page status", async () => {
    const expectedStatus = {{ (chrome_extension_name ~ " options ready") | tojson }};

    await import("../../src/options.js");

    expect(document.querySelector("[data-options-status]")?.textContent).toBe(expectedStatus);
  });
});
