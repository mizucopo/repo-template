import { beforeEach, describe, expect, it, vi } from "vitest";

describe("content script entrypoint", () => {
  beforeEach(() => {
    vi.resetModules();
    delete document.documentElement.dataset.chromeExtensionTemplate;
  });

  it("marks the active document with the extension name", async () => {
    const extensionName = {{ chrome_extension_name | tojson }};

    await import("../../src/content.js");

    expect(document.documentElement.dataset.chromeExtensionTemplate).toBe(extensionName);
  });
});
